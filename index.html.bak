  </svg>
</a>

<script>
  const siteNav = document.getElementById('siteNav');
  const menuToggle = document.querySelector('.menu-toggle');
  const menuCloseTargets = document.querySelectorAll('[data-menu-close], .mobile-drawer a');
  const trustTriggers = document.querySelectorAll('[data-trust-trigger]');
  const trustPanel = document.getElementById('trustPanel');
  const desktopTrustQuery = window.matchMedia('(min-width: 981px)');
  let trustTimer;

  const updateNavState = () => {
    siteNav.classList.toggle('nav-scrolled', window.scrollY > 12);
  };

  const setMenuState = (isOpen) => {
    document.body.classList.toggle('menu-open', isOpen);
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.setAttribute('aria-label', 'Open menu');
  };

  const showTrustPanel = () => {
    if (!desktopTrustQuery.matches) return;
    window.clearTimeout(trustTimer);
    siteNav.classList.add('trust-visible');
  };

  const hideTrustPanel = () => {
    trustTimer = window.setTimeout(() => {
      siteNav.classList.remove('trust-visible');
    }, 120);
  };

  updateNavState();
  window.addEventListener('scroll', updateNavState, {passive:true});

  menuToggle.addEventListener('click', () => {
    setMenuState(!document.body.classList.contains('menu-open'));
  });

  menuCloseTargets.forEach((target) => {
    target.addEventListener('click', () => setMenuState(false));
  });

  trustTriggers.forEach((trigger) => {
    trigger.addEventListener('mouseenter', showTrustPanel);
    trigger.addEventListener('focus', showTrustPanel);
    trigger.addEventListener('mouseleave', hideTrustPanel);
    trigger.addEventListener('blur', hideTrustPanel);
  });

  trustPanel.addEventListener('mouseenter', showTrustPanel);
  trustPanel.addEventListener('mouseleave', hideTrustPanel);

  const img305 = document.getElementById('img30_5');
  const img307 = document.getElementById('img30_7');
  const img306 = document.getElementById('img30_6');

  function adjustImg305() {
    if (!img305 || !img306) return;
    // img306 is bottom:0 so its top = containerHeight - img306.offsetHeight
    const container = img306.parentElement;
    const containerH = container.offsetHeight;
    const top306 = containerH - img306.offsetHeight;
    img305.style.top = Math.max(0, top306) + 'px';
  }

  // Hero 3-image adjustment
  const heroImg305 = document.getElementById('heroImg305');
  const heroImg306 = document.getElementById('heroImg306');
  const heroImg307 = document.getElementById('heroImg307');
  function adjustHeroImg305() {
    if (!heroImg305 || !heroImg306) return;
    const container = heroImg306.parentElement;
    const containerH = container.offsetHeight;
    const top306 = containerH - heroImg306.offsetHeight;
    heroImg305.style.top = Math.max(0, top306) + 'px';
  }

  // Run after images load and on resize
  if (img307) img307.addEventListener('load', adjustImg305);
  if (img305) img305.addEventListener('load', adjustImg305);
  if (img306) img306.addEventListener('load', adjustImg305);
  window.addEventListener('resize', adjustImg305, {passive:true});
  // Also run whenever menu opens
  menuToggle.addEventListener('click', () => {
    setTimeout(adjustImg305, 50);
  });
  // Run on load
  window.addEventListener('load', adjustImg305);
  adjustImg305();

  // Hero image events
  if (heroImg307) heroImg307.addEventListener('load', adjustHeroImg305);
  if (heroImg305) heroImg305.addEventListener('load', adjustHeroImg305);
  if (heroImg306) heroImg306.addEventListener('load', adjustHeroImg305);
  window.addEventListener('resize', adjustHeroImg305, {passive:true});
  window.addEventListener('load', adjustHeroImg305);
  adjustHeroImg305();

  // Mobile hero 3-image adjustment
  const hmImg305 = document.getElementById('hmImg305');
  const hmImg306 = document.getElementById('hmImg306');
  const hmImg307 = document.getElementById('hmImg307');
  function adjustHmImg305() {
    if (!hmImg305 || !hmImg306) return;
    const container = hmImg306.parentElement;
    const containerH = container.offsetHeight;
    const top306 = containerH - hmImg306.offsetHeight;
    hmImg305.style.top = Math.max(0, top306) + 'px';
  }
  if (hmImg307) hmImg307.addEventListener('load', adjustHmImg305);
  if (hmImg305) hmImg305.addEventListener('load', adjustHmImg305);
  if (hmImg306) hmImg306.addEventListener('load', adjustHmImg305);
  window.addEventListener('resize', adjustHmImg305, {passive:true});
  window.addEventListener('load', adjustHmImg305);
  adjustHmImg305();

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuState(false);
      siteNav.classList.remove('trust-visible');
    }
  });
</script>

</body>
</html>
