<style>
/* ═══════════════════════════════════════════
   SERVICES SECTION — Premium Redesign
   ═══════════════════════════════════════════ */
.svc-section{
  background:#ffffff;
  padding:100px 0 80px;
  position:relative;
}

/* Header */
.svc-header{
  max-width:1200px;margin:0 auto;
  padding:0 2rem 64px;
  text-align:center;
}
.svc-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-family:'Montserrat',sans-serif;
  font-size:10px;font-weight:700;letter-spacing:2.8px;text-transform:uppercase;
  color:var(--secondary);
  background:rgba(234,246,255,0.8);
  border:1px solid rgba(30,136,229,0.18);
  border-radius:20px;padding:6px 16px;
  margin-bottom:22px;
}
.svc-eyebrow-dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--secondary);
  animation:svcDotPulse 2.4s ease-in-out infinite;
}
@keyframes svcDotPulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.65);}}
.svc-title{
  font-family:'League Spartan',sans-serif;
  font-size:clamp(2.2rem,3.8vw,3.4rem);
  font-weight:800;color:#1A1A1A;
  line-height:1.05;letter-spacing:-0.5px;
  margin-bottom:16px;
}
.svc-desc{
  font-family:'DM Sans',sans-serif;
  font-size:17px;color:#5F6B7A;
  line-height:1.7;max-width:520px;margin:0 auto;
}

/* 3-column grid */
.svc-grid{
  max-width:1200px;margin:0 auto;
  padding:0 2rem;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:24px;
  margin-bottom:40px;
}

/* Card base */
.svc-card{
  background:#ffffff;
  border:1px solid rgba(230,238,248,0.9);
  border-radius:28px;
  overflow:hidden;
  display:flex;flex-direction:column;
  box-shadow:0 4px 28px rgba(15,76,129,0.06),0 1px 4px rgba(15,76,129,0.03);
  transition:
    transform 0.4s cubic-bezier(0.22,1,0.36,1),
    box-shadow 0.4s cubic-bezier(0.22,1,0.36,1),
    border-color 0.3s ease;
  /* fade-up init */
  opacity:0;
  transform:translateY(32px);
}
.svc-card.svc-visible{
  opacity:1;transform:translateY(0);
}
.svc-card:hover{
  transform:translateY(-7px);
  box-shadow:0 24px 64px rgba(15,76,129,0.14),0 4px 16px rgba(15,76,129,0.07);
  border-color:rgba(30,136,229,0.22);
}

/* Photo panel */
.svc-card-photo{
  position:relative;
  height:220px;
  overflow:hidden;
  flex-shrink:0;
}
.svc-card-photo img{
  width:100%;height:100%;
  object-fit:cover;object-position:center;
  display:block;
  transition:transform 0.65s cubic-bezier(0.22,1,0.36,1);
}
.svc-card:hover .svc-card-photo img{
  transform:scale(1.06);
}
.svc-card-photo-overlay{
  position:absolute;inset:0;
  background:linear-gradient(
    to bottom,
    rgba(15,76,129,0.10) 0%,
    rgba(15,76,129,0.30) 60%,
    rgba(7,52,93,0.55) 100%
  );
}
.svc-card-photo-overlay--dark{
  background:linear-gradient(
    to bottom,
    rgba(7,52,93,0.18) 0%,
    rgba(7,52,93,0.42) 60%,
    rgba(7,52,93,0.72) 100%
  );
}
.svc-card-photo-tag{
  position:absolute;bottom:16px;left:20px;
  display:flex;align-items:center;gap:10px;
}
.svc-card-num-sm{
  font-family:'League Spartan',sans-serif;
  font-size:1rem;font-weight:900;
  color:rgba(255,255,255,0.5);
  letter-spacing:-0.5px;
  line-height:1;
}
.svc-card-label-sm{
  font-family:'Montserrat',sans-serif;
  font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  color:rgba(255,255,255,0.82);
  background:rgba(255,255,255,0.12);
  border:1px solid rgba(255,255,255,0.2);
  border-radius:20px;
  padding:4px 12px;
  backdrop-filter:blur(8px);
}

/* Card body */
.svc-card-body{
  padding:30px 30px 28px;
  display:flex;flex-direction:column;
  flex:1;
}

/* Featured (middle) card — dark blue body */
.svc-card--featured{
  background:linear-gradient(155deg,#0A3D6E 0%,#0F4C81 45%,#1462A8 100%);
  border-color:transparent;
  box-shadow:0 16px 56px rgba(15,76,129,0.28),0 4px 16px rgba(15,76,129,0.16);
}
.svc-card--featured:hover{
  transform:translateY(-7px);
  box-shadow:0 28px 72px rgba(15,76,129,0.34),0 8px 24px rgba(15,76,129,0.18);
  border-color:transparent;
}
.svc-card--featured .svc-card-body{
  background:transparent;
}

/* Title */
.svc-card-title{
  font-family:'League Spartan',sans-serif;
  font-size:1.7rem;font-weight:800;
  color:#1A1A1A;line-height:1.05;
  letter-spacing:-0.2px;
  margin-bottom:10px;
}
.svc-card--featured .svc-card-title{color:#ffffff;}

/* Sub */
.svc-card-sub{
  font-family:'DM Sans',sans-serif;
  font-size:13.5px;color:#5F6B7A;line-height:1.65;
  margin-bottom:22px;
}
.svc-card--featured .svc-card-sub{color:rgba(255,255,255,0.6);}

/* Treatment list */
.svc-treatments{
  list-style:none;
  display:flex;flex-direction:column;gap:14px;
  margin-bottom:28px;
  flex:1;
}
.svc-treatments li{
  display:flex;align-items:flex-start;gap:11px;
}
.svc-treat-dot{
  width:5px;height:5px;border-radius:50%;
  background:var(--secondary);
  flex-shrink:0;margin-top:7px;
}
.svc-card--featured .svc-treat-dot{background:#7DD3FC;}
.svc-treatments li div{display:flex;flex-direction:column;gap:1px;}
.svc-treatments li strong{
  font-family:'DM Sans',sans-serif;
  font-size:13.5px;font-weight:600;color:#1A1A1A;
}
.svc-card--featured .svc-treatments li strong{color:#ffffff;}
.svc-treatments li span{
  font-family:'DM Sans',sans-serif;
  font-size:12px;color:#5F6B7A;line-height:1.5;
}
.svc-card--featured .svc-treatments li span{color:rgba(255,255,255,0.5);}

/* CTA button */
.svc-card-cta{
  display:inline-flex;align-items:center;gap:8px;
  font-family:'Montserrat',sans-serif;
  font-size:12px;font-weight:700;letter-spacing:0.3px;
  color:var(--primary);
  background:rgba(234,246,255,0.9);
  border:1px solid rgba(30,136,229,0.18);
  border-radius:999px;
  padding:12px 20px;
  text-decoration:none;
  transition:background 0.28s,border-color 0.28s,color 0.28s,transform 0.28s,box-shadow 0.28s;
  align-self:flex-start;
}
.svc-card-cta:hover{
  background:var(--primary);color:#ffffff;
  border-color:var(--primary);
  transform:translateY(-1px);
  box-shadow:0 8px 24px rgba(15,76,129,0.22);
}
.svc-card-cta svg{width:14px;height:14px;transition:transform 0.25s;}
.svc-card-cta:hover svg{transform:translateX(3px);}
.svc-card-cta--white{
  background:rgba(255,255,255,0.13);
  border-color:rgba(255,255,255,0.22);
  color:#ffffff;
}
.svc-card-cta--white:hover{
  background:#ffffff;color:var(--primary);border-color:#ffffff;
  box-shadow:0 8px 28px rgba(0,0,0,0.18);
}

/* Top accent line on hover */
.svc-card::before{
  content:'';
  position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--primary),var(--secondary));
  transform:scaleX(0);transform-origin:left;
  transition:transform 0.4s cubic-bezier(0.22,1,0.36,1);
  z-index:2;
}
.svc-card:hover::before{transform:scaleX(1);}
.svc-card--featured::before{
  background:linear-gradient(90deg,rgba(255,255,255,0.25),rgba(125,211,252,0.5));
  transform:scaleX(1);
}

/* Stagger delays */
.svc-card:nth-child(1){transition-delay:0ms;}
.svc-card:nth-child(2){transition-delay:100ms;}
.svc-card:nth-child(3){transition-delay:200ms;}

/* ── Secondary tags ── */
.svc-secondary{
  max-width:1200px;margin:0 auto;
  padding:0 2rem;
}
.svc-tag-label{
  font-family:'Montserrat',sans-serif;
  font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  color:#A0AFBF;
  margin-bottom:16px;
  text-align:center;
}
.svc-tags{
  display:flex;align-items:center;
  gap:0;
  background:#ffffff;
  border:1px solid rgba(230,238,248,0.95);
  border-radius:20px;
  padding:24px 36px;
  box-shadow:0 2px 16px rgba(15,76,129,0.04);
  flex-wrap:wrap;
}
.svc-tag{
  display:flex;align-items:center;gap:14px;
  flex:1;min-width:220px;
  padding:6px 0;
}
.svc-tag-icon{
  width:42px;height:42px;border-radius:12px;
  background:rgba(234,246,255,0.8);
  border:1px solid rgba(30,136,229,0.12);
  display:flex;align-items:center;justify-content:center;
  color:var(--primary);
  flex-shrink:0;
}
.svc-tag-icon svg{width:18px;height:18px;}
.svc-tag div{display:flex;flex-direction:column;gap:2px;}
.svc-tag strong{
  font-family:'DM Sans',sans-serif;
  font-size:14px;font-weight:600;color:#1A1A1A;
}
.svc-tag span{
  font-size:12.5px;color:#5F6B7A;
  font-family:'DM Sans',sans-serif;
}
.svc-tag-divider{
  width:1px;height:48px;
  background:rgba(230,238,248,1);
  margin:0 36px;
  flex-shrink:0;
}

/* ── RESPONSIVE ── */
@media(max-width:980px){
  .svc-grid{grid-template-columns:1fr;gap:20px;}
  .svc-card--featured{order:-1;}
  .svc-card-photo{height:240px;}
}
@media(max-width:600px){
  .svc-section{padding:72px 0 60px;}
  .svc-header{padding-bottom:44px;}
  .svc-title{font-size:2rem;}
  .svc-grid{padding:0 1.25rem;gap:16px;}
  .svc-card{border-radius:22px;}
  .svc-card-photo{height:200px;}
  .svc-card-body{padding:24px 22px 22px;}
  .svc-card-title{font-size:1.5rem;}
  .svc-secondary{padding:0 1.25rem;}
  .svc-tags{
    flex-direction:column;
    align-items:flex-start;
    gap:20px;padding:20px 22px;border-radius:16px;
  }
  .svc-tag-divider{width:100%;height:1px;margin:0;}
}
</style>

<script>
(function(){
  var cards = document.querySelectorAll('.svc-card');
  if(!cards.length) return;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        e.target.classList.add('svc-visible');
        io.unobserve(e.target);
      }
    });
  },{threshold:0.1});
  cards.forEach(function(c){ io.observe(c); });
})();
</script>


