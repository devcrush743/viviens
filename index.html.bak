}
</style>

<script>
(function(){
  var img305t = document.getElementById('tsImg305');
  var img306t = document.getElementById('tsImg306');
  var img307t = document.getElementById('tsImg307');
  function adjustTsImg305(){
    if(!img305t || !img306t) return;
    var container = img306t.parentElement;
    var containerH = container.offsetHeight;
    var top306 = containerH - img306t.offsetHeight;
    img305t.style.top = Math.max(0, top306) + 'px';
  }
  if(img307t) img307t.addEventListener('load', adjustTsImg305);
  if(img305t) img305t.addEventListener('load', adjustTsImg305);
  if(img306t) img306t.addEventListener('load', adjustTsImg305);
  window.addEventListener('resize', adjustTsImg305, {passive:true});
  window.addEventListener('load', adjustTsImg305);
  adjustTsImg305();
})();
</script>

<!-- JS: scroll-fade for trust cards -->
<script>
(function(){
  var cards = document.querySelectorAll('.ts-card');
  if(!cards.length) return;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('ts-visible'); io.unobserve(e.target); }
    });
  },{threshold:0.12});
  cards.forEach(function(c){ io.observe(c); });
})();
</script>


