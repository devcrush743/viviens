}
</style>

<script>
(function(){
  var i305 = document.getElementById('mdsImg305');
  var i306 = document.getElementById('mdsImg306');
  var i307 = document.getElementById('mdsImg307');
  function adjust(){
    if(!i305 || !i306) return;
    var containerH = i306.parentElement.offsetHeight;
    var top306 = containerH - i306.offsetHeight;
    i305.style.top = Math.max(0, top306) + 'px';
  }
  if(i305) i305.addEventListener('load', adjust);
  if(i306) i306.addEventListener('load', adjust);
  if(i307) i307.addEventListener('load', adjust);
  window.addEventListener('resize', adjust, {passive:true});
  window.addEventListener('load', adjust);
  adjust();
})();
</script>

