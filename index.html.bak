<!-- ═══════════════════════════════════════════════════
     WHY DERMALLURE — Horizontal scroll cards
     ═══════════════════════════════════════════════════ -->
<section class="wdc-section" id="why-dermallure">

  <!-- Sticky wrapper: tall enough so 4 cards scroll one at a time -->
  <div class="wdc-sticky-outer">
    <div class="wdc-sticky">

      <!-- Section header -->
      <div class="wdc-header">
        <div class="wdc-eyebrow">
          <span class="wdc-eyebrow-dot"></span>
          Why Cadmus
        </div>
        <h2 class="wdc-title">Expertise you can <em>trust</em></h2>
        <p class="wdc-sub">Four pillars that set Cadmus apart — scroll to discover.</p>
      </div>

      <!-- Progress bar -->
      <div class="wdc-progress-wrap" aria-hidden="true">
        <div class="wdc-progress-bar"><div class="wdc-progress-fill" id="wdcProgressFill"></div></div>
      </div>

      <!-- Horizontal track -->
      <div class="wdc-track-outer">
        <div class="wdc-track" id="wdcTrack">

          <!-- Card 1 — Qualified -->
          <div class="wdc-card" data-idx="0">
            <span class="wdc-card-num">01</span>
            <div class="wdc-card-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </div>
            <div class="wdc-card-label">Credentials</div>
            <h3 class="wdc-card-title">Qualified Specialist</h3>
            <p class="wdc-card-desc">BDS qualified — with deep expertise across root canal, implants, composite fillings, and cosmetic dental treatments. Every consultation is led by a board-qualified dentist, not a technician.</p>
            <div class="wdc-card-tag">🎓 BDS · Dental Surgery</div>
          </div>

          <!-- Card 2 — Patient-first -->
          <div class="wdc-card" data-idx="1">
            <span class="wdc-card-num">02</span>
            <div class="wdc-card-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <div class="wdc-card-label">Patient Experience</div>
            <h3 class="wdc-card-title">Patient‑First Approach</h3>
            <p class="wdc-card-desc">Consistently praised for being soft-spoken, thorough, and genuinely invested in outcomes. At Cadmus, you're never just a case number — you're a patient who deserves real attention.</p>
            <div class="wdc-card-tag">🤝 Trusted by hundreds of patients</div>
          </div>

          <!-- Card 3 — Equipment -->
          <div class="wdc-card" data-idx="2">
            <span class="wdc-card-num">03</span>
            <div class="wdc-card-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
            </div>
            <div class="wdc-card-label">Technology</div>
            <h3 class="wdc-card-title">Advanced Equipment</h3>
            <p class="wdc-card-desc">Cadmus Multispeciality Dental Care is equipped with the latest dentistry and aesthetic technology. From precision laser systems to cutting-edge skin analysis tools — modern care, clinical results.</p>
            <div class="wdc-card-tag">⚙️ Latest laser &amp; aesthetic tech</div>
          </div>

          <!-- Card 4 — Locations -->
          <div class="wdc-card" data-idx="3">
            <span class="wdc-card-num">04</span>
            <div class="wdc-card-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="wdc-card-label">Accessibility</div>
            <h3 class="wdc-card-title">Multiple Locations</h3>
            <p class="wdc-card-desc">Serving patients across Viman Nagar and Pune — bringing specialist dental care closer to home. Quality dental care should never be out of reach.</p>
            <div class="wdc-card-tag">📍 Viman Nagar · Pune</div>
          </div>

        </div><!-- /wdc-track -->
      </div><!-- /wdc-track-outer -->

      <!-- Dot navigation -->
      <div class="wdc-dots" aria-label="Card navigation">
        <button class="wdc-dot active" aria-label="Card 1" data-dot="0"></button>
        <button class="wdc-dot" aria-label="Card 2" data-dot="1"></button>
        <button class="wdc-dot" aria-label="Card 3" data-dot="2"></button>
        <button class="wdc-dot" aria-label="Card 4" data-dot="3"></button>
      </div>

    </div><!-- /wdc-sticky -->
  </div><!-- /wdc-sticky-outer -->

</section>

<style>
/* ═══════════════════════════════════════════
   WHY DERMALLURE — full styles
   ═══════════════════════════════════════════ */
.wdc-section{
  background:linear-gradient(160deg,#07345D 0%,#0F4C81 40%,#1462A8 75%,#1E88E5 100%);
  position:relative;
  /* No overflow:hidden — it breaks position:sticky on children */
}
/* subtle noise texture */
.wdc-section::before{
  content:'';
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse 60% 50% at 80% 20%,rgba(255,255,255,0.06) 0%,transparent 60%),
    radial-gradient(ellipse 40% 60% at 10% 80%,rgba(255,255,255,0.04) 0%,transparent 60%);
  pointer-events:none;z-index:0;
}

/* Sticky scroll outer — 400vh so each of 4 cards gets ~100vh of vertical scroll */
.wdc-sticky-outer{
  height:400vh;
  position:relative;
  z-index:1;
}
.wdc-sticky{
  position:sticky;
  top:0;
  height:100vh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:80px 0 40px;
  overflow:hidden;
}

/* Header */
.wdc-header{
  text-align:center;
  padding:0 2rem;
  margin-bottom:32px;
}
.wdc-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-family:'Montserrat',sans-serif;
  font-size:10px;font-weight:700;letter-spacing:2.8px;text-transform:uppercase;
  color:rgba(255,255,255,0.7);
  background:rgba(255,255,255,0.09);
  border:1px solid rgba(255,255,255,0.16);
  border-radius:20px;padding:6px 16px;
  margin-bottom:18px;
}
.wdc-eyebrow-dot{
  width:6px;height:6px;border-radius:50%;
  background:#60C0FF;
  animation:wdcPulse 2.4s ease-in-out infinite;
}
@keyframes wdcPulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.65);}}
.wdc-title{
  font-family:'League Spartan',sans-serif;
  font-size:clamp(2rem,3.5vw,3.2rem);
  font-weight:800;color:#ffffff;
  line-height:1.05;letter-spacing:-0.5px;
  margin-bottom:10px;
}
.wdc-title em{font-style:normal;color:#7DD3FC;}
.wdc-sub{
  font-family:'DM Sans',sans-serif;
  font-size:15px;color:rgba(255,255,255,0.55);
  line-height:1.6;
}

/* Progress bar */
.wdc-progress-wrap{
  padding:0 2rem;max-width:1200px;margin:0 auto 28px;width:100%;
}
.wdc-progress-bar{
  height:1.5px;
  background:rgba(255,255,255,0.12);
  border-radius:2px;overflow:hidden;
}
.wdc-progress-fill{
  height:100%;width:25%;
  background:linear-gradient(90deg,rgba(255,255,255,0.4),rgba(125,211,252,0.8));
  border-radius:2px;
  transition:width 0.5s cubic-bezier(0.22,1,0.36,1);
}

/* Track */
.wdc-track-outer{
  overflow:hidden;
  padding:8px 0 8px;
}
.wdc-track{
  display:flex;
  gap:24px;
  padding:0 calc((100vw - 1200px)/2);
  /* No CSS transition — JS drives it frame-by-frame via scroll */
  will-change:transform;
}
@media(max-width:1240px){.wdc-track{padding:0 2rem;}}

/* Card */
.wdc-card{
  flex:0 0 320px;
  background:rgba(255,255,255,0.06);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:28px;
  padding:38px 32px 34px;
  position:relative;overflow:hidden;
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  transition:
    transform 0.55s cubic-bezier(0.22,1,0.36,1),
    box-shadow 0.55s cubic-bezier(0.22,1,0.36,1),
    border-color 0.4s ease,
    opacity 0.55s ease,
    background 0.4s ease;
  opacity:0.38;
  transform:scale(0.94) translateY(10px);
  cursor:default;
}
.wdc-card.wdc-active{
  opacity:1;
  transform:scale(1) translateY(0);
  background:rgba(255,255,255,0.11);
  border-color:rgba(125,211,252,0.28);
  box-shadow:
    0 0 0 1px rgba(125,211,252,0.12),
    0 24px 64px rgba(0,0,0,0.28),
    0 4px 16px rgba(0,0,0,0.16);
}
.wdc-card:hover{opacity:1;transform:scale(1.01) translateY(-4px);}

/* Shimmering top border on active */
.wdc-card::before{
  content:'';
  position:absolute;top:0;left:28px;right:28px;height:2px;
  border-radius:0 0 3px 3px;
  background:linear-gradient(90deg,transparent,rgba(125,211,252,0.7),rgba(255,255,255,0.5),rgba(125,211,252,0.7),transparent);
  transform:scaleX(0);transform-origin:left;
  transition:transform 0.55s cubic-bezier(0.22,1,0.36,1);
}
.wdc-card.wdc-active::before{transform:scaleX(1);}

/* Card number */
.wdc-card-num{
  position:absolute;top:26px;right:26px;
  font-family:'League Spartan',sans-serif;
  font-size:3.2rem;font-weight:900;
  color:rgba(255,255,255,0.06);
  line-height:1;letter-spacing:-2px;
  user-select:none;
  transition:color 0.4s;
}
.wdc-card.wdc-active .wdc-card-num{color:rgba(125,211,252,0.12);}

/* Icon */
.wdc-card-icon{
  width:54px;height:54px;border-radius:16px;
  background:rgba(255,255,255,0.1);
  border:1px solid rgba(255,255,255,0.14);
  display:flex;align-items:center;justify-content:center;
  margin-bottom:26px;
  transition:background 0.4s,border-color 0.4s,box-shadow 0.4s;
}
.wdc-card.wdc-active .wdc-card-icon{
  background:rgba(125,211,252,0.15);
  border-color:rgba(125,211,252,0.3);
  box-shadow:0 0 20px rgba(125,211,252,0.15);
}
.wdc-card-icon svg{
  width:24px;height:24px;
  stroke:#ffffff;fill:none;
  stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;
  transition:stroke 0.4s;
}
.wdc-card.wdc-active .wdc-card-icon svg{stroke:#7DD3FC;}

/* Text */
.wdc-card-label{
  font-family:'Montserrat',sans-serif;
  font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  color:rgba(125,211,252,0.75);
  margin-bottom:10px;
  transition:color 0.4s;
}
.wdc-card.wdc-active .wdc-card-label{color:#7DD3FC;}
.wdc-card-title{
  font-family:'League Spartan',sans-serif;
  font-size:1.4rem;font-weight:800;
  color:#ffffff;line-height:1.1;
  letter-spacing:-0.2px;margin-bottom:14px;
}
.wdc-card-desc{
  font-family:'DM Sans',sans-serif;
  font-size:14px;color:rgba(255,255,255,0.6);
  line-height:1.7;margin-bottom:22px;
}
.wdc-card-tag{
  display:inline-flex;align-items:center;gap:6px;
  font-family:'Montserrat',sans-serif;
  font-size:10.5px;font-weight:600;
  color:rgba(255,255,255,0.5);
  background:rgba(255,255,255,0.07);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:999px;
  padding:6px 14px;
  transition:color 0.4s,background 0.4s,border-color 0.4s;
}
.wdc-card.wdc-active .wdc-card-tag{
  color:rgba(125,211,252,0.85);
  background:rgba(125,211,252,0.08);
  border-color:rgba(125,211,252,0.2);
}

/* Dots */
.wdc-dots{
  display:flex;justify-content:center;gap:8px;
  padding:28px 0 0;
}
.wdc-dot{
  width:8px;height:8px;border-radius:50%;
  background:rgba(255,255,255,0.2);
  border:none;padding:0;cursor:pointer;
  transition:all 0.35s cubic-bezier(0.22,1,0.36,1);
}
.wdc-dot.active{
  width:28px;border-radius:4px;
  background:rgba(255,255,255,0.75);
}

/* ─── MOBILE: free scroll ─── */
@media(max-width:768px){
  .wdc-sticky-outer{height:auto;}
  .wdc-sticky{
    position:static;height:auto;
    padding:64px 0 48px;
  }
  .wdc-track-outer{
    overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;
  }
  .wdc-track-outer::-webkit-scrollbar{display:none;}
  .wdc-track{padding:0 1.25rem;gap:16px;transition:none;}
  .wdc-card{
    flex:0 0 280px;opacity:1;transform:none;
    border-radius:22px;padding:30px 26px;
  }
  .wdc-card::before{transform:scaleX(1);}
  .wdc-progress-wrap{display:none;}
  .wdc-card-num{font-size:2.6rem;top:20px;right:20px;}
}
</style>

<script>
(function(){
  var track   = document.getElementById('wdcTrack');
  var fill    = document.getElementById('wdcProgressFill');
  var cards   = document.querySelectorAll('.wdc-card');
  var dots    = document.querySelectorAll('.wdc-dot');
  var outer   = document.querySelector('.wdc-sticky-outer');
  if(!track || !outer) return;

  var TOTAL = cards.length; // 4

  function update(){
    var isMobile = window.innerWidth <= 768;
    if(isMobile) return;

    var rect     = outer.getBoundingClientRect();
    var outerH   = outer.offsetHeight;          // 400vh
    var vh       = window.innerHeight;

    // scrolled = how far we've scrolled INTO the sticky zone (0 → outerH - vh)
    var scrolled = -rect.top;
    if(scrolled < 0) scrolled = 0;
    var maxScroll = outerH - vh;
    if(maxScroll <= 0) maxScroll = 1;

    // progress: 0 → 1 over the full sticky scroll range
    var progress = Math.min(1, Math.max(0, scrolled / maxScroll));

    // Continuous translate: move the track by one card-width per 1/TOTAL progress
    // Total horizontal travel = (TOTAL-1) cards × card slot width
    var cardSlot = 320 + 24; // card flex-basis + gap
    var maxX = cardSlot * (TOTAL - 1);
    var translateX = progress * maxX;
    track.style.transform = 'translateX(-' + translateX + 'px)';

    // Active card index (snap for highlight only)
    var idx = Math.min(TOTAL - 1, Math.floor(progress * TOTAL));
    // Edge: at 100% progress show last card
    if(progress >= 1) idx = TOTAL - 1;

    cards.forEach(function(c, i){ c.classList.toggle('wdc-active', i === idx); });
    dots.forEach(function(d, i){ d.classList.toggle('active', i === idx); });
    if(fill) fill.style.width = ((progress) * 100) + '%';
  }

  // Dot click — scroll page to corresponding position in the sticky zone
  dots.forEach(function(d){
    d.addEventListener('click', function(){
      var idx = parseInt(d.getAttribute('data-dot'), 10);
      var outerTop = outer.getBoundingClientRect().top + window.scrollY;
      var outerH   = outer.offsetHeight;
      var vh       = window.innerHeight;
      var maxScroll = outerH - vh;
      var target = outerTop + (idx / (TOTAL - 1)) * maxScroll;
      window.scrollTo({ top: target, behavior: 'smooth' });
    });
  });

  update();
  window.addEventListener('scroll', update, {passive:true});
  window.addEventListener('resize', update, {passive:true});
})();
</script>

