<!-- SERVICES -->
<section class="svc-section" id="services">

  <!-- Header -->
  <div class="svc-header">
    <div class="svc-eyebrow">
      <span class="svc-eyebrow-dot"></span>
      Our Services
    </div>
    <h2 class="svc-title">Complete Care For Your<br>Smile &amp; Wellness</h2>
    <p class="svc-desc">Personalized treatments designed to address your dental and oral health concerns with expert medical guidance.</p>
  </div>

  <!-- 3 Primary Cards -->
  <div class="svc-grid">

    <!-- Card 1: Root Canal -->
    <div class="svc-card" data-svc="skin">
      <!-- Photo panel -->
      <div class="svc-card-photo">
        <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=800&q=80&auto=format&fit=crop" alt="Dental treatment" loading="lazy">
        <div class="svc-card-photo-overlay"></div>
        <div class="svc-card-photo-tag">
          <span class="svc-card-num-sm">01</span>
          <span class="svc-card-label-sm">Root Canal</span>
        </div>
      </div>
      <!-- Content -->
      <div class="svc-card-body">
        <h3 class="svc-card-title">Root Canal<br>Treatments</h3>
        <p class="svc-card-sub">Medical-grade solutions for every dental concern — from routine care to advanced restoration.</p>
        <ul class="svc-treatments">
          <li>
            <span class="svc-treat-dot"></span>
            <div>
              <strong>Acne &amp; Acne Scars</strong>
              <span>Targeted treatment for active breakouts &amp; scarring</span>
            </div>
          </li>
          <li>
            <span class="svc-treat-dot"></span>
            <div>
              <strong>Pigmentation &amp; Uneven Tone</strong>
              <span>Brighten and even your complexion</span>
            </div>
          </li>
          <li>
            <span class="svc-treat-dot"></span>
            <div>
              <strong>Root Canal Therapy</strong>
              <span>Restore glow, texture &amp; youthful clarity</span>
            </div>
          </li>
        </ul>
        <a href="" onclick="Calendly.initPopupWidget({url:'https://calendly.com/cadmusdental'});return false;" class="svc-card-cta">
          Book Dental Consultation
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <!-- Card 2: Implants -->
    <div class="svc-card svc-card--featured" data-svc="hair">
      <!-- Photo panel -->
      <div class="svc-card-photo">
        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=800&q=80&auto=format&fit=crop" alt="Hair care treatment" loading="lazy">
        <div class="svc-card-photo-overlay svc-card-photo-overlay--dark"></div>
        <div class="svc-card-photo-tag">
          <span class="svc-card-num-sm">02</span>
          <span class="svc-card-label-sm">Implants</span>
        </div>
      </div>
      <!-- Content -->
      <div class="svc-card-body">
        <h3 class="svc-card-title">Implant<br>Treatments</h3>
        <p class="svc-card-sub">Clinically proven approaches to restore missing teeth, function and confidence.</p>
        <ul class="svc-treatments">
          <li>
            <span class="svc-treat-dot"></span>
            <div>
              <strong>Dental Implants</strong>
              <span>Diagnose the issue &amp; restore missing teeth</span>
            </div>
          </li>
          <li>
            <span class="svc-treat-dot"></span>
            <div>
              <strong>Gum &amp; Bone Health</strong>
              <span>Dandruff, scalp care &amp; nutrition therapy</span>
            </div>
          </li>
          <li>
            <span class="svc-treat-dot"></span>
            <div>
              <strong>Implant Restoration</strong>
              <span>PRP, mesotherapy &amp; growth treatments</span>
            </div>
          </li>
        </ul>
        <a href="" onclick="Calendly.initPopupWidget({url:'https://calendly.com/cadmusdental'});return false;" class="svc-card-cta svc-card-cta--white">
          Book Implant Consultation
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <!-- Card 3: Laser & Aesthetics -->
    <div class="svc-card" data-svc="laser">
      <!-- Photo panel -->
      <div class="svc-card-photo">
        <img src="https://images.unsplash.com/photo-1612908223093-f206aa80e3af?w=800&q=80&auto=format&fit=crop" alt="Laser aesthetic treatment" loading="lazy">
        <div class="svc-card-photo-overlay"></div>
        <div class="svc-card-photo-tag">
          <span class="svc-card-num-sm">03</span>
          <span class="svc-card-label-sm">Laser &amp; Aesthetics</span>
        </div>
      </div>
      <!-- Content -->
      <div class="svc-card-body">
        <h3 class="svc-card-title">Laser &amp;<br>Aesthetic Care</h3>
        <p class="svc-card-sub">Advanced technology-driven procedures for precise, visible, lasting results.</p>
        <ul class="svc-treatments">
          <li>
            <span class="svc-treat-dot"></span>
            <div>
              <strong>Laser Treatments</strong>
              <span>Composite fillings &amp; tooth-coloured restorations</span>
            </div>
          </li>
          <li>
            <span class="svc-treat-dot"></span>
            <div>
              <strong>Braces &amp; Aligners</strong>
              <span>Straighten teeth with clear aligners</span>
            </div>
          </li>
          <li>
            <span class="svc-treat-dot"></span>
            <div>
              <strong>Cosmetic Dentistry</strong>
              <span>Hydrafacial, microneedling &amp; BB Glow</span>
            </div>
          </li>
        </ul>
        <a href="" onclick="Calendly.initPopupWidget({url:'https://calendly.com/cadmusdental'});return false;" class="svc-card-cta">
          Book Laser Consultation
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

  </div><!-- /svc-grid -->

  <!-- Secondary service tags -->
  <div class="svc-secondary">
    <div class="svc-tag-label">Also available at Cadmus</div>
    <div class="svc-tags">

      <div class="svc-tag">
        <div class="svc-tag-icon">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H7z" stroke="currentColor" stroke-width="1.5"/><path d="M9 12h6M12 9v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
        <div>
          <strong>Nail Care</strong>
          <span>Nail disorders, infections &amp; treatments</span>
        </div>
      </div>

      <div class="svc-tag-divider"></div>

      <div class="svc-tag">
        <div class="svc-tag-icon">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.5"/><path d="M5 20c0-3.87 3.13-7 7-7s7 3.13 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
        <div>
          <strong>General Physician Consultation</strong>
