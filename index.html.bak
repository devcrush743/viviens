<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Cadmus Multispeciality Dental Care – Dr. Sudiksha Jaiswal | Dental Clinic, Viman Nagar, Pune</title>
<link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
<script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=League+Spartan:wght@100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Montserrat:ital,wght@0,100..900;1,100..900&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet"/>
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{overflow-x:hidden;}
  :root{
    --primary:#0F4C81;
    --secondary:#1E88E5;
    --background:#F8FBFF;
    --surface:#FFFFFF;
    --text:#1A1A1A;
    --text-muted:#5F6B7A;
    --border:#E6EEF8;
    --accent-light:#EAF6FF;
    --navy:var(--primary);
    --navy-dark:#07345D;
    --blue:var(--secondary);
    --blue-light:var(--secondary);
    --blue-pale:var(--accent-light);
    --blue-mist:var(--background);
    --white:var(--surface);
    --bg:var(--background);
    --shadow-soft:0 24px 70px rgba(15,76,129,0.12);
  }
  html{scroll-behavior:smooth;}
  body{font-family:'DM Sans',sans-serif;color:var(--text);background:var(--bg);line-height:1.6;}

  /* NAV */
  .site-nav{position:fixed;top:0;left:0;right:0;z-index:100;height:80px;background:transparent;border-bottom:1px solid transparent;transition:background 0.35s ease,border-color 0.35s ease,box-shadow 0.35s ease,backdrop-filter 0.35s ease;}
  .site-nav.nav-scrolled{background:rgba(248,251,255,0.82);border-bottom-color:rgba(230,238,248,0.9);box-shadow:0 14px 45px rgba(15,76,129,0.08);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);}
  body.menu-open .site-nav{background:rgba(248,251,255,0.96);border-bottom-color:rgba(230,238,248,0.95);box-shadow:0 10px 30px rgba(15,76,129,0.08);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);}
  .nav-inner{max-width:1200px;margin:0 auto;padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:100%;gap:1rem;}
  .logo-wrap{display:inline-flex;align-items:center;text-decoration:none;flex-shrink:0;transition:transform 0.28s ease,opacity 0.28s ease;}
  .logo-wrap:hover{transform:translateY(-1px);opacity:0.92;}
  .brand-logo{width:60px;height:60px;object-fit:contain;object-position:center;display:block;border-radius:12px;}
  .nav-links{display:flex;align-items:center;gap:1.8rem;list-style:none;white-space:nowrap;flex:1;justify-content:center;overflow:hidden;}
  .nav-links a{text-decoration:none;color:rgba(26,26,26,0.74);font-size:13px;font-weight:560;font-family:'Montserrat',sans-serif;letter-spacing:0.2px;display:inline-flex;transition:color 0.28s ease,transform 0.28s ease;}
  .nav-links a:hover,
  .nav-links a:focus-visible{color:var(--secondary);transform:translateY(-2px);outline:none;}
  .nav-actions{display:flex;align-items:center;gap:1rem;flex-shrink:0;}
  .nav-cta{background:var(--primary);color:var(--white)!important;padding:12px 22px;border-radius:999px;font-size:13px!important;font-weight:650;font-family:'Montserrat',sans-serif;letter-spacing:0.15px;text-decoration:none;box-shadow:0 12px 32px rgba(15,76,129,0.22);transition:transform 0.28s ease,background 0.28s ease,box-shadow 0.28s ease,color 0.28s ease;}
  .nav-cta:hover,
  .nav-cta:focus-visible{background:var(--secondary)!important;color:var(--white)!important;transform:translateY(-2px);box-shadow:0 16px 40px rgba(30,136,229,0.24);outline:none;}
  .nav-trust-panel{position:absolute;top:calc(100% + 14px);right:2rem;width:310px;opacity:0;pointer-events:none;transform:translateY(12px) scale(0.98);transition:opacity 0.3s ease,transform 0.3s ease;z-index:120;}
  .site-nav.trust-visible .nav-trust-panel,
  .site-nav:has([data-trust-trigger]:hover) .nav-trust-panel,
  .site-nav:has([data-trust-trigger]:focus-visible) .nav-trust-panel,
  .site-nav:has(.nav-trust-panel:hover) .nav-trust-panel{opacity:1;pointer-events:auto;transform:translateY(0) scale(1);}
  .trust-card{background:rgba(255,255,255,0.94);border:1px solid rgba(230,238,248,0.96);border-radius:24px;padding:22px;box-shadow:var(--shadow-soft);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);text-align:center;}
  .trust-divider{height:1px;width:74px;background:var(--secondary);margin:0 auto 18px;}
  .trust-divider.bottom{margin:18px auto 0;}
  .doctor-card-image{display:block;width:100%;height:auto;border-radius:18px;border:1px solid rgba(230,238,248,0.96);box-shadow:0 16px 34px rgba(15,76,129,0.14);}
  .trust-name{font-family:'Playfair Display',serif;font-size:1.35rem;line-height:1.15;color:var(--text);font-weight:700;margin-bottom:4px;}
  .trust-degree{font-size:12px;text-transform:uppercase;letter-spacing:1.8px;color:var(--secondary);font-family:'Montserrat',sans-serif;font-weight:700;margin-bottom:8px;}
  .trust-specialty{font-size:13px;color:var(--text-muted);margin-bottom:12px;}
  .trust-metric{font-size:13px;font-weight:650;color:var(--text);margin-bottom:6px;}
  .trust-stars{font-size:13px;letter-spacing:1.5px;color:var(--secondary);margin-bottom:18px;}
  .trust-card .nav-cta{display:inline-flex;align-items:center;justify-content:center;margin-top:16px;padding:11px 19px;box-shadow:none;}
  .menu-toggle{display:none;width:40px;height:40px;border:0;border-radius:0;background:transparent;align-items:center;justify-content:center;flex-direction:column;gap:5px;cursor:pointer;transition:transform 0.28s ease;}
  .menu-toggle:hover{transform:translateY(-1px);}
  .menu-toggle span{width:19px;height:1.5px;background:var(--primary);border-radius:999px;transition:transform 0.28s ease,opacity 0.2s ease,background 0.2s ease;}
  .menu-toggle:hover span{background:var(--secondary);}
  .menu-close{display:none;width:40px;height:40px;border:0;border-radius:0;background:transparent;align-items:center;justify-content:center;cursor:pointer;color:var(--primary);transition:transform 0.28s ease,color 0.2s ease;}
  .menu-close:hover{color:var(--secondary);transform:translateY(-1px);}
  .menu-close svg{width:22px;height:22px;display:block;}
  .mobile-backdrop{position:fixed;inset:0;background:rgba(15,76,129,0.12);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);opacity:0;pointer-events:none;transition:opacity 0.32s ease;z-index:90;}
  .mobile-drawer{position:fixed;inset:0;width:100%;height:100%;min-height:100svh;background:rgba(255,255,255,0.05);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);z-index:95;transform:translateX(100%);transition:transform 0.38s cubic-bezier(0.22,1,0.36,1);display:flex;flex-direction:column;padding:calc(72px + env(safe-area-inset-top,0px)) 0 0;overflow:hidden;box-shadow:none;gap:0;}
  .mobile-drawer::before{content:'';position:absolute;inset:0;background:none;pointer-events:none;z-index:0;}
  .mobile-links,.mobile-trust-card{position:relative;z-index:1;}
  body.menu-open{overflow:hidden;}
  body.menu-open .mobile-backdrop{opacity:1;pointer-events:auto;}
  body.menu-open .mobile-drawer{transform:translateX(0);}
  .mobile-links{list-style:none;margin:0;padding:24px 20px 28px 32px;flex:0 0 auto;display:flex;flex-direction:column;justify-content:flex-start;gap:2px;}
  .mobile-links li{opacity:0;transform:translateY(8px);transition:opacity 0.34s ease,transform 0.34s ease;display:flex;align-items:center;flex:0 0 auto;overflow:hidden;}
  .mobile-trust-card{display:none;}
  body.menu-open .mobile-links li,
  body.menu-open .mobile-trust-card{opacity:1;transform:translateY(0);}
  body.menu-open .mobile-links li:nth-child(1){transition-delay:0.04s;}
  body.menu-open .mobile-links li:nth-child(2){transition-delay:0.08s;}
  body.menu-open .mobile-links li:nth-child(3){transition-delay:0.12s;}
  body.menu-open .mobile-links li:nth-child(4){transition-delay:0.16s;}
  body.menu-open .mobile-links li:nth-child(5){transition-delay:0.2s;}
  body.menu-open .mobile-links li:nth-child(6){transition-delay:0.24s;}
  body.menu-open .mobile-trust-card{transition-delay:0.28s;}
  .mobile-links a{font-family:'League Spartan',sans-serif;font-size:28px;line-height:1;text-decoration:none;color:#ffffff;-webkit-text-fill-color:#ffffff;font-weight:700;letter-spacing:0;transition:color 0.25s ease,opacity 0.25s ease;display:block;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .mobile-links a:hover,
  .mobile-links a:focus-visible{color:#cce8ff;-webkit-text-fill-color:#cce8ff;opacity:0.9;outline:none;}
  .drawer-divider{display:none;}
  .mobile-trust-card .trust-card{flex:1;min-height:0;width:100%;padding:0;background:transparent;border:0;border-radius:0;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none;overflow:hidden;display:flex;align-items:flex-end;}
  .mobile-trust-card .trust-divider{display:none;}
  .mobile-trust-card .doctor-card-image{width:100%;height:100%;object-fit:cover;object-position:left bottom;border:0;border-radius:0;box-shadow:none;display:block;transform:scale(1.06);transform-origin:left bottom;}

  /* ── DESKTOP HERO — Premium 1440px redesign ── */
  .btn-primary{background:var(--primary);color:var(--white);padding:14px 28px;border-radius:999px;font-weight:600;font-size:15px;text-decoration:none;display:inline-flex;align-items:center;gap:8px;transition:all 0.28s ease;box-shadow:0 14px 36px rgba(15,76,129,0.22);}
  .btn-primary:hover{background:var(--secondary);color:var(--white);transform:translateY(-2px);box-shadow:0 20px 44px rgba(30,136,229,0.28);}
  .btn-outline{border:1.5px solid rgba(15,76,129,0.2);color:var(--primary);padding:13px 28px;border-radius:999px;font-weight:600;font-size:15px;text-decoration:none;display:inline-flex;align-items:center;gap:8px;transition:all 0.28s ease;background:#ffffff;}
  .btn-outline:hover{border-color:var(--secondary);background:var(--accent-light);color:var(--secondary);transform:translateY(-2px);}

  /* HERO WRAPPER */
  .hero{
    min-height:88vh;
    background:#ffffff;
    display:flex;
    flex-direction:column;
    padding-top:80px;
    position:relative;
    overflow:hidden;
  }

  /* Very subtle background decorations */
  .hero::before{
    content:'';
    position:absolute;
    top:-120px;right:-120px;
    width:600px;height:600px;
    border-radius:50%;
    background:radial-gradient(circle,rgba(234,246,255,0.55) 0%,transparent 70%);
    pointer-events:none;
    z-index:0;
  }
  .hero::after{
    content:'';
    position:absolute;
    bottom:-80px;left:-60px;
    width:400px;height:400px;
    border-radius:50%;
    background:radial-gradient(circle,rgba(234,246,255,0.35) 0%,transparent 70%);
    pointer-events:none;
    z-index:0;
  }

  /* DESKTOP TWO-COLUMN INNER */
  .hero-inner{
    max-width:1200px;
    margin:0 auto;
    padding:5rem 2rem 3rem;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:5rem;
    align-items:center;
    position:relative;
    z-index:1;
    flex:1;
  }

  /* ── LEFT COLUMN ── */
  .hero-left{
    display:flex;
    flex-direction:column;
    gap:0;
    /* slide-up animation */
    animation:heroSlideUp 0.75s cubic-bezier(0.22,1,0.36,1) both;
  }
  @keyframes heroSlideUp{
    from{opacity:0;transform:translateY(32px);}
    to{opacity:1;transform:translateY(0);}
  }

  /* Eyebrow */
  .hero-eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;
    letter-spacing:2.8px;text-transform:uppercase;
    color:var(--secondary);
    background:rgba(234,246,255,0.72);
    border:1px solid rgba(30,136,229,0.18);
    border-radius:20px;
    padding:6px 14px;
    margin-bottom:24px;
    width:fit-content;
  }
  .hero-eyebrow-dot{
    width:6px;height:6px;border-radius:50%;
    background:var(--secondary);
    animation:heroPulse 2.4s ease-in-out infinite;
  }
  @keyframes heroPulse{
    0%,100%{opacity:1;transform:scale(1);}
    50%{opacity:0.5;transform:scale(0.7);}
  }

  /* Main headline */
  .hero-h1{
    font-family:'League Spartan',sans-serif;
    font-size:clamp(3rem,4.2vw,4.8rem);
    font-weight:800;
    color:#1A1A1A;
    line-height:1.0;
    letter-spacing:-1px;
    margin-bottom:22px;
  }
  .hero-h1 .h1-accent{
    color:var(--primary);
    display:block;
  }

  /* Supporting text */
  .hero-support{
    font-family:'DM Sans',sans-serif;
    font-size:16px;
    color:#5F6B7A;
    line-height:1.7;
    max-width:420px;
    margin-bottom:32px;
  }

  /* Trust checkmarks */
  .hero-checks{
    display:flex;flex-direction:column;gap:12px;
    margin-bottom:40px;
  }
  .hero-check{
    display:flex;align-items:center;gap:10px;
    font-size:14px;font-weight:600;
    color:#1A1A1A;
    font-family:'DM Sans',sans-serif;
  }
  .hero-check-icon{
    width:22px;height:22px;border-radius:50%;
    background:rgba(234,246,255,0.9);
    border:1.5px solid rgba(30,136,229,0.25);
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
  }
  .hero-check-icon svg{width:11px;height:11px;stroke:var(--primary);stroke-width:2.5;fill:none;}

  /* CTA row */
  .hero-actions{
    display:flex;gap:14px;flex-wrap:wrap;
    margin-bottom:0;
  }

  /* ── RIGHT COLUMN ── */
  .hero-right{
    position:relative;
    display:flex;
    align-items:flex-end;
    justify-content:flex-start;
    min-height:500px;
    animation:heroFadeIn 0.9s cubic-bezier(0.22,1,0.36,1) 0.2s both;
  }
  @keyframes heroFadeIn{
    from{opacity:0;transform:translateY(20px);}
    to{opacity:1;transform:translateY(0);}
  }

  /* Glow circle behind image */
  .hero-img-glow{
    position:absolute;
    bottom:0;left:50%;
    transform:translateX(-50%);
    width:420px;height:420px;
    border-radius:50%;
    background:radial-gradient(ellipse at 50% 60%,rgba(30,136,229,0.11) 0%,rgba(234,246,255,0.18) 40%,transparent 72%);
    z-index:0;
    pointer-events:none;
  }

  /* Doctor image */
  .hero-doctor-img{
    position:relative;z-index:1;
    width:100%;
    max-width:380px;
    height:auto;
    display:block;
    filter:drop-shadow(0 24px 48px rgba(15,76,129,0.10));
    border-radius:28px;
    margin:0 auto;
  }

  /* Floating credential cards */
  .hero-float-card{
    position:absolute;
    background:rgba(255,255,255,0.95);
    border:1px solid rgba(230,238,248,0.95);
    border-radius:20px;
    padding:14px 18px;
    box-shadow:0 12px 40px rgba(15,76,129,0.12),0 2px 8px rgba(15,76,129,0.06);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
    z-index:10;
    animation:heroFloat 5s ease-in-out infinite;
  }
  .hero-float-card:nth-child(3){animation-delay:-2.5s;}
  @keyframes heroFloat{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-7px);}
  }

  /* Card 1 — top left */
  .hfc-1{
    top:48px;left:-20px;
    min-width:148px;
  }
  /* Card 2 — bottom right */
  .hfc-2{
    bottom:70px;right:-16px;
    min-width:158px;
  }

  .hfc-accent{
    width:3px;height:32px;
    border-radius:3px;
    background:linear-gradient(180deg,var(--primary),var(--secondary));
    flex-shrink:0;
  }
  .hfc-inner{display:flex;align-items:center;gap:11px;}
  .hfc-text{}
  .hfc-val{
    font-family:'League Spartan',sans-serif;
    font-size:1.45rem;font-weight:800;
    color:#1A1A1A;line-height:1.1;
    display:block;
  }
  .hfc-val em{font-style:normal;color:var(--primary);}
  .hfc-lbl{
    font-size:11px;font-weight:600;
    font-family:'Montserrat',sans-serif;
    text-transform:uppercase;letter-spacing:1px;
    color:#5F6B7A;
    display:block;margin-top:2px;
  }

  /* ── BOTTOM TRUST STRIP — animated marquee ── */
  .hero-strip{
    border-top:1px solid rgba(230,238,248,0.9);
    background:#ffffff;
    position:relative;z-index:1;
    overflow:hidden;
    -webkit-mask-image:linear-gradient(to right,transparent 0%,black 8%,black 92%,transparent 100%);
    mask-image:linear-gradient(to right,transparent 0%,black 8%,black 92%,transparent 100%);
  }
  @media(max-width:768px){
    .hero-strip{ display:block !important; order:10; }
    .hero-strip-desktop{ display:none !important; }
    .hero-strip-mobile{ display:block !important; }
  }
  @media(min-width:769px){
    .hero-strip-mobile{ display:none !important; }
  }
  .hero-strip-track{
    display:flex;
    align-items:center;
    gap:0;
    width:max-content;
    padding:17px 0;
    animation:stripScroll 22s linear infinite;
  }
  .hero-strip:hover .hero-strip-track{
    animation-play-state:paused;
  }
  @keyframes stripScroll{
    0%  { transform:translateX(0); }
    100%{ transform:translateX(-50%); }
  }
  /* one "set" of items — duplicated in HTML for seamless loop */
  .hero-strip-item{
    display:inline-flex;align-items:center;gap:8px;
    font-size:13px;
    font-family:'DM Sans',sans-serif;
    color:#5F6B7A;
    font-weight:500;
    white-space:nowrap;
    padding:0 28px;
  }
  .hero-strip-item svg{width:13px;height:13px;stroke:var(--secondary);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}
  /* separator diamond */
  .hero-strip-sep{
    display:inline-flex;align-items:center;
    color:rgba(30,136,229,0.35);
    font-size:10px;
    padding:0 4px;
    flex-shrink:0;
  }
  /* star pulse */
  .hero-strip-stars{
    color:var(--secondary);
    letter-spacing:1.5px;
    font-size:11px;
    animation:starGlow 2.8s ease-in-out infinite;
  }
  @keyframes starGlow{
    0%,100%{opacity:1;}
    50%{opacity:0.55;}
  }
  /* highlight items */
  .hero-strip-item.strip-hi{
    color:#1A1A1A;
    font-weight:600;
  }
  .hero-strip-item.strip-hi svg{stroke:var(--primary);}

  /* legacy .hero-badge, .hero-card hide on desktop (now unused) */
  .hero-badge,.hero-stats,.hero-sub,.hero-qual,.hero-card{display:none !important;}

  /* ── RESPONSIVE: tablet ── */
  @media(max-width:1050px){
    .hero-inner{gap:3rem;padding:4rem 2rem 2.5rem;}
    .hero-h1{font-size:3.2rem;}
    .hfc-1{left:-10px;}
    .hfc-2{right:-10px;}
  }

  /* ── MOBILE HERO (≤ 768px) — Premium 60/40 redesign ── */
  @media(max-width:768px){
    .hero{
      min-height:unset;
      padding-top:72px;
      background:#ffffff;
      display:block;
      overflow:visible;
    }
    .hero-inner{ display:none !important; }

    /* Outer wrapper */
    .hero-mobile{
      display:flex;
      flex-direction:column;
      background:#ffffff;
      position:relative;
      overflow:hidden;
    }

    /* ── TOP WHITE SECTION (≈60%) ── */
    .hm-top{
      padding:32px 22px 28px;
      background:#ffffff;
      position:relative;
      z-index:2;
      animation:hmSlideUp 0.7s cubic-bezier(0.22,1,0.36,1) both;
    }
    @keyframes hmSlideUp{
      from{opacity:0;transform:translateY(24px);}
      to{opacity:1;transform:translateY(0);}
    }

    /* Clinic name tag */
    .hm-clinic-tag{
      display:inline-flex;align-items:center;gap:7px;
      font-family:'Montserrat',sans-serif;
      font-size:9px;font-weight:700;
      letter-spacing:2.5px;text-transform:uppercase;
      color:var(--secondary);
      background:rgba(234,246,255,0.75);
      border:1px solid rgba(30,136,229,0.18);
      border-radius:20px;
      padding:5px 12px;
      margin-bottom:14px;
    }
    .hm-clinic-dot{
      width:5px;height:5px;border-radius:50%;
      background:var(--secondary);
      animation:hmPulse 2.2s ease-in-out infinite;
    }
    @keyframes hmPulse{
      0%,100%{opacity:1;transform:scale(1);}
      50%{opacity:0.4;transform:scale(0.65);}
    }

    /* Subheadline above main h1 */
    .hm-sub-head{
      font-family:'DM Sans',sans-serif;
      font-size:13px;font-weight:500;
      color:#5F6B7A;
      letter-spacing:0.2px;
      margin-bottom:8px;
      line-height:1.5;
    }

    /* Main headline */
    .hm-h1{
      font-family:'League Spartan',sans-serif;
      font-size:2.6rem;font-weight:800;
      color:#1A1A1A;
      line-height:1.0;
      letter-spacing:-0.5px;
      margin-bottom:14px;
    }
    .hm-h1 .hm-h1-blue{color:var(--primary);}

    /* Supporting text */
    .hm-desc{
      font-family:'DM Sans',sans-serif;
      font-size:14px;color:#5F6B7A;
      line-height:1.65;
      margin-bottom:24px;
      max-width:310px;
    }

    /* CTA */
    .hm-cta{
      display:flex;align-items:center;justify-content:center;
      width:100%;
      background:var(--primary);
      color:#ffffff;
      font-family:'Montserrat',sans-serif;
      font-size:14px;font-weight:700;
      letter-spacing:0.2px;
      text-align:center;
      padding:16px 20px;
      border-radius:999px;
      text-decoration:none;
      box-shadow:0 14px 36px rgba(15,76,129,0.24),0 3px 10px rgba(15,76,129,0.10);
      transition:transform 0.22s ease,box-shadow 0.22s ease,background 0.22s ease;
      gap:8px;
    }
    .hm-cta:hover,.hm-cta:active{
      background:var(--secondary);
      transform:translateY(-2px);
      box-shadow:0 20px 44px rgba(30,136,229,0.28);
    }
    .hm-cta-arrow{
      display:inline-flex;align-items:center;justify-content:center;
      width:20px;height:20px;border-radius:50%;
      background:rgba(255,255,255,0.2);
      font-size:13px;line-height:1;
    }

    /* ── BLUE IMAGE SECTION (≈40%) ── */
    .hm-image-section{
      background:transparent;
      position:relative;
      padding:0;
      overflow:hidden;
      height:100vw;
      min-height:320px;
      max-height:520px;
      display:block;
      animation:hmFadeIn 0.85s cubic-bezier(0.22,1,0.36,1) 0.2s both;
    }
    .hm-image-section img{
      animation:hmImgReveal 1s cubic-bezier(0.22,1,0.36,1) 0.35s both;
    }
    @keyframes hmImgReveal{
      from{opacity:0;transform:translateY(20px) scale(0.97);}
      to{opacity:1;transform:translateY(0) scale(1);}
    }
    /* Hide desktop marquee strip on mobile */
    .hero-strip{ display:none; }
    @keyframes hmFadeIn{
      from{opacity:0;transform:translateY(16px);}
      to{opacity:1;transform:translateY(0);}
    }

    /* Decorative background circle */
    .hm-bg-circle{
      position:absolute;
      top:-60px;right:-60px;
      width:260px;height:260px;
      border-radius:50%;
      background:rgba(255,255,255,0.06);
      pointer-events:none;
    }
    .hm-bg-circle-2{
      position:absolute;
      bottom:-40px;left:-40px;
      width:180px;height:180px;
      border-radius:50%;
      background:rgba(255,255,255,0.04);
      pointer-events:none;
    }

    /* Floating trust card */
    .hm-trust-card{
      background:rgba(255,255,255,0.97);
      border-radius:20px;
      padding:14px 18px;
      box-shadow:0 16px 48px rgba(0,0,0,0.18),0 4px 12px rgba(0,0,0,0.08);
      border:1px solid rgba(255,255,255,0.5);
      width:100%;
      max-width:310px;
      margin-bottom:20px;
      position:relative;z-index:5;
      animation:hmFloat 5s ease-in-out infinite;
      display:flex;align-items:center;gap:14px;
    }
    @keyframes hmFloat{
      0%,100%{transform:translateY(0);}
      50%{transform:translateY(-5px);}
    }

    /* Blue vertical accent */
    .hm-tc-bar{
      width:3.5px;height:44px;
      border-radius:3px;
      background:linear-gradient(180deg,var(--primary),var(--secondary));
      flex-shrink:0;
    }

    .hm-tc-body{}
    .hm-tc-name{
      font-family:'League Spartan',sans-serif;
      font-size:1.05rem;font-weight:800;
      color:#1A1A1A;
      line-height:1.1;
      display:block;
    }
    .hm-tc-qual{
      font-family:'Montserrat',sans-serif;
      font-size:9.5px;font-weight:700;
      text-transform:uppercase;letter-spacing:1.2px;
      color:var(--secondary);
      display:block;margin-top:3px;
    }
    .hm-tc-spec{
      font-size:11.5px;color:#5F6B7A;
      font-family:'DM Sans',sans-serif;
      display:block;margin-top:4px;
      font-weight:500;
    }

    /* Doctor image */
    .hm-doctor-img{
      position:relative;z-index:2;
      width:85%;
      max-width:290px;
      height:auto;
      display:block;
      filter:drop-shadow(0 -12px 32px rgba(0,0,0,0.15));
      margin:0 auto;
      /* subtle scale-up on load */
      animation:hmImgReveal 1s cubic-bezier(0.22,1,0.36,1) 0.35s both;
    }
    @keyframes hmImgReveal{
      from{opacity:0;transform:translateY(20px) scale(0.97);}
      to{opacity:1;transform:translateY(0) scale(1);}
    }

    /* ── BOTTOM TRUST ROW ── */
    .hm-bottom-trust{
      background:var(--primary);
      padding:14px 22px;
      display:flex;flex-direction:column;align-items:center;gap:10px;
    }
    .hm-checks-row{
      display:flex;align-items:center;gap:18px;
    }
    .hm-chk{
      display:flex;align-items:center;gap:5px;
      font-family:'Montserrat',sans-serif;
      font-size:11px;font-weight:700;
      color:rgba(255,255,255,0.92);
      letter-spacing:0.3px;
    }
    .hm-chk-icon{
      width:16px;height:16px;border-radius:50%;
      background:rgba(255,255,255,0.18);
      display:flex;align-items:center;justify-content:center;
      flex-shrink:0;
    }
    .hm-chk-icon svg{width:8px;height:8px;stroke:#fff;stroke-width:2.5;fill:none;}
    .hm-bottom-tag{
      font-family:'DM Sans',sans-serif;
      font-size:11px;
      color:rgba(255,255,255,0.55);
      letter-spacing:0.3px;
      text-align:center;
    }
  }

  /* Hide mobile hero on desktop */
  @media(min-width:769px){
    .hero-mobile{ display:none; }
  }

  /* ── TRUST SECTION ── */
  .trust-section{
    background:transparent;
    padding:72px 0 80px;
    position:relative;
  }
  .trust-section .container{max-width:1200px;margin:0 auto;padding:0 2rem;}

  /* Header */
  .ts-header{text-align:center;margin-bottom:56px;}
  .ts-eyebrow{
    display:inline-flex;align-items:center;gap:7px;
    font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;
    letter-spacing:2.5px;text-transform:uppercase;
    color:var(--secondary);
    background:rgba(234,246,255,0.75);
    border:1px solid rgba(30,136,229,0.16);
    border-radius:20px;
    padding:5px 14px;
    margin-bottom:20px;
  }
  .ts-eyebrow svg{width:12px;height:12px;flex-shrink:0;opacity:0.85;}
  .ts-title{
    font-family:'League Spartan',sans-serif;
    font-size:2.5rem;font-weight:800;
    color:#1A1A1A;
    line-height:1.1;
    letter-spacing:-0.3px;
    margin-bottom:14px;
  }
  .ts-sub{
    font-size:16px;color:#5F6B7A;
    line-height:1.7;
    max-width:500px;margin:0 auto;
  }

  /* Cards grid */
  .ts-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
    margin-bottom:48px;
  }

  /* Single card */
  .ts-card{
    background:#ffffff;
    border:1px solid rgba(230,238,248,0.95);
    border-radius:24px;
    padding:32px 26px 28px;
    position:relative;
    overflow:hidden;
    box-shadow:0 4px 24px rgba(15,76,129,0.06),0 1px 4px rgba(15,76,129,0.04);
    transition:transform 0.32s cubic-bezier(0.22,1,0.36,1),
               box-shadow 0.32s cubic-bezier(0.22,1,0.36,1),
               border-color 0.28s ease;
    /* scroll fade-up — starts hidden */
    opacity:0;
    transform:translateY(28px);
  }
  .ts-card.ts-visible{
    opacity:1;
    transform:translateY(0);
  }
  .ts-card:hover{
    transform:translateY(-5px);
    box-shadow:0 16px 48px rgba(15,76,129,0.11),0 4px 12px rgba(15,76,129,0.06);
    border-color:rgba(30,136,229,0.22);
  }

  /* Blue accent top line */
  .ts-card::before{
    content:'';
    position:absolute;
    top:0;left:24px;right:24px;
    height:2.5px;
    border-radius:0 0 3px 3px;
    background:linear-gradient(90deg,var(--primary),var(--secondary));
    opacity:0;
    transition:opacity 0.28s ease;
  }
  .ts-card:hover::before,.ts-card.ts-accent::before{opacity:1;}

  /* Icon pill */
  .ts-icon{
    width:44px;height:44px;
    border-radius:12px;
    background:rgba(234,246,255,0.85);
    border:1px solid rgba(30,136,229,0.13);
    display:flex;align-items:center;justify-content:center;
    margin-bottom:20px;
  }
  .ts-icon svg{width:20px;height:20px;stroke:var(--primary);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}

  /* Card content */
  .ts-card-value{
    font-family:'League Spartan',sans-serif;
    font-size:1.9rem;font-weight:800;
    color:#1A1A1A;
    line-height:1.05;
    margin-bottom:5px;
    letter-spacing:-0.2px;
  }
  .ts-card-value span{color:var(--primary);}
  .ts-card-label{
    font-size:12px;
    font-family:'Montserrat',sans-serif;
    font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
    color:var(--secondary);
    margin-bottom:10px;
  }
  .ts-card-desc{
    font-size:14px;color:#5F6B7A;line-height:1.6;
  }

  /* Credential badge */
  .ts-badge-wrap{
    display:flex;justify-content:center;
  }
  .ts-cred-badge{
    display:inline-flex;align-items:center;gap:9px;
    background:#ffffff;
    border:1px solid rgba(230,238,248,0.95);
    border-radius:999px;
    padding:10px 20px;
    box-shadow:0 4px 20px rgba(15,76,129,0.07);
    font-size:13px;color:#5F6B7A;
  }
  .ts-cred-badge svg{width:16px;height:16px;flex-shrink:0;}
  .ts-cred-badge strong{color:#1A1A1A;font-weight:600;}

  /* Stagger delays */
  .ts-card:nth-child(1){transition-delay:0ms;}
  .ts-card:nth-child(2){transition-delay:80ms;}
  .ts-card:nth-child(3){transition-delay:160ms;}
  .ts-card:nth-child(4){transition-delay:240ms;}

  /* Mobile */
  @media(max-width:860px){
    .ts-title{font-size:1.9rem;}
  }
  @media(max-width:540px){
    .ts-grid{grid-template-columns:1fr;gap:14px;}
    .trust-section{padding:52px 0 60px;}
    .ts-header{margin-bottom:36px;}
    .ts-title{font-size:1.65rem;}
    .ts-card{padding:26px 22px 22px;}
    .ts-cred-badge{
      font-size:12px;
      padding:10px 16px;
      text-align:center;
      flex-wrap:wrap;
      justify-content:center;
      gap:6px;
      line-height:1.6;
    }
  }

  /* SECTION COMMONS */
  section{padding:5rem 0;}
  .container{max-width:1200px;margin:0 auto;padding:0 2rem;}
  .section-eyebrow{font-family:'Montserrat',sans-serif;font-size:10px;text-transform:uppercase;letter-spacing:2.8px;color:var(--secondary);font-weight:700;margin-bottom:0.75rem;}
  .section-title{font-family:'League Spartan',sans-serif;font-size:clamp(2.2rem,3.8vw,3.2rem);font-weight:800;color:#1A1A1A;margin-bottom:1rem;line-height:1.05;letter-spacing:-0.5px;}
  .section-sub{font-family:'DM Sans',sans-serif;font-size:16px;color:var(--text-muted);max-width:540px;line-height:1.7;}

  /* TRUST BAR */
  .trust-bar{background:var(--blue-mist);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:1.5rem 0;}
  .trust-inner{max-width:1200px;margin:0 auto;padding:0 2rem;display:flex;justify-content:space-around;align-items:center;flex-wrap:wrap;gap:1.5rem;}
  .trust-item{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--navy);font-weight:500;}
  .trust-icon{font-size:22px;}

  /* ABOUT */
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;margin-top:3rem;}
  .about-visual{background:var(--accent-light);border-radius:16px;padding:3rem;text-align:center;border:1px solid var(--border);}
  .about-doctor-card{max-width:300px;margin:0 auto 1.5rem;}
  .dr-name{font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--navy);font-weight:700;}
  .dr-qual{font-size:13px;color:var(--blue);font-weight:500;margin:4px 0 1rem;letter-spacing:0.5px;}
  .dr-speciality{font-size:13px;color:var(--text-muted);}
  .credential-badges{display:flex;justify-content:center;gap:10px;margin-top:1.5rem;flex-wrap:wrap;}
  .badge{background:var(--white);border:1px solid var(--border);border-radius:20px;padding:5px 14px;font-size:12px;color:var(--navy);font-weight:500;}
  .about-points{display:flex;flex-direction:column;gap:1.25rem;margin-top:1.5rem;}
  .about-point{display:flex;gap:14px;align-items:flex-start;}
  .point-icon{width:38px;height:38px;border-radius:8px;background:var(--blue-pale);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;border:1px solid var(--border);}
  .point-text h4{font-size:15px;font-weight:600;color:var(--navy);margin-bottom:2px;}
  .point-text p{font-size:13px;color:var(--text-muted);}

  /* ── ABOUT SCROLL CARDS ── */
  .about-cards-section{
    background:#ffffff;
    padding:80px 0 0;
  }
  .acs-header{
    max-width:1200px;margin:0 auto;
    padding:0 2rem 56px;
  }
  .acs-eyebrow{
    display:inline-flex;align-items:center;gap:7px;
    font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;
    letter-spacing:2.5px;text-transform:uppercase;
    color:var(--secondary);
    background:rgba(234,246,255,0.75);
    border:1px solid rgba(30,136,229,0.18);
    border-radius:20px;
    padding:5px 14px;
    margin-bottom:20px;
  }
  .acs-eyebrow-dot{
    width:5px;height:5px;border-radius:50%;
    background:var(--secondary);
    animation:acsPulse 2.4s ease-in-out infinite;
  }
  @keyframes acsPulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.65);}}
  .acs-title{
    font-family:'League Spartan',sans-serif;
    font-size:clamp(2rem,3.2vw,3rem);
    font-weight:800;color:#1A1A1A;
    line-height:1.05;letter-spacing:-0.4px;
    margin-bottom:14px;
  }
  .acs-title em{font-style:normal;color:var(--primary);}
  .acs-sub{
    font-size:16px;color:#5F6B7A;line-height:1.7;max-width:480px;
  }

  /* Sticky scroll container */
  .acs-sticky-wrap{
    position:relative;
  }
  .acs-sticky{
    position:sticky;
    top:88px; /* below nav */
    overflow:hidden;
    padding:0 0 64px;
  }

  /* Horizontal track */
  .acs-track-outer{
    overflow:hidden;
    padding:8px 0 20px;
  }
  .acs-track{
    display:flex;
    gap:24px;
    padding:0 calc((100vw - 1200px)/2) 0 calc((100vw - 1200px)/2);
    transition:transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94);
    will-change:transform;
  }
  @media(max-width:1240px){
    .acs-track{padding:0 2rem;}
  }

  /* Individual card */
  .acs-card{
    flex:0 0 300px;
    background:#ffffff;
    border:1px solid rgba(230,238,248,0.95);
    border-radius:28px;
    padding:36px 30px 32px;
    box-shadow:0 4px 28px rgba(15,76,129,0.06),0 1px 4px rgba(15,76,129,0.04);
    transition:transform 0.4s cubic-bezier(0.22,1,0.36,1),
               box-shadow 0.4s cubic-bezier(0.22,1,0.36,1),
               border-color 0.3s ease,
               opacity 0.4s ease;
    position:relative;
    overflow:hidden;
    opacity:0.45;
    transform:scale(0.96) translateY(8px);
  }
  .acs-card.acs-active{
    opacity:1;
    transform:scale(1) translateY(0);
    box-shadow:0 20px 60px rgba(15,76,129,0.13),0 4px 16px rgba(15,76,129,0.07);
    border-color:rgba(30,136,229,0.2);
  }
  .acs-card:hover{
    transform:scale(1.02) translateY(-4px);
    box-shadow:0 24px 64px rgba(15,76,129,0.16);
    border-color:rgba(30,136,229,0.3);
    opacity:1;
  }

  /* Blue top accent bar */
  .acs-card::before{
    content:'';
    position:absolute;
    top:0;left:28px;right:28px;height:3px;
    border-radius:0 0 4px 4px;
    background:linear-gradient(90deg,var(--primary),var(--secondary));
    transform:scaleX(0);
    transition:transform 0.4s cubic-bezier(0.22,1,0.36,1);
    transform-origin:left;
  }
  .acs-card.acs-active::before,.acs-card:hover::before{transform:scaleX(1);}

  /* Card number */
  .acs-num{
    font-family:'League Spartan',sans-serif;
    font-size:3.5rem;font-weight:900;
    color:rgba(234,246,255,0.95);
    line-height:1;
    position:absolute;
    top:24px;right:24px;
    letter-spacing:-2px;
    user-select:none;
    transition:color 0.3s;
  }
  .acs-card.acs-active .acs-num{color:rgba(30,136,229,0.12);}

  /* Icon */
  .acs-icon{
    width:52px;height:52px;
    border-radius:16px;
    background:rgba(234,246,255,0.8);
    border:1px solid rgba(30,136,229,0.14);
    display:flex;align-items:center;justify-content:center;
    margin-bottom:24px;
    transition:background 0.3s,border-color 0.3s;
  }
  .acs-card.acs-active .acs-icon{
    background:rgba(15,76,129,0.07);
    border-color:rgba(15,76,129,0.2);
  }
  .acs-icon svg{width:22px;height:22px;stroke:var(--primary);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}

  /* Text */
  .acs-card-title{
    font-family:'League Spartan',sans-serif;
    font-size:1.25rem;font-weight:800;
    color:#1A1A1A;line-height:1.1;
    margin-bottom:12px;
    letter-spacing:-0.2px;
  }
  .acs-card-label{
    font-family:'Montserrat',sans-serif;
    font-size:9.5px;font-weight:700;
    text-transform:uppercase;letter-spacing:1.8px;
    color:var(--secondary);
    margin-bottom:14px;
    display:block;
  }
  .acs-card-desc{
    font-family:'DM Sans',sans-serif;
    font-size:14px;color:#5F6B7A;line-height:1.65;
  }

  /* Dot nav */
  .acs-dots{
    display:flex;justify-content:center;gap:8px;
    padding:32px 0 0;
  }
  .acs-dot{
    width:8px;height:8px;border-radius:50%;
    background:rgba(30,136,229,0.2);
    cursor:pointer;
    transition:all 0.3s ease;
    border:none;padding:0;
  }
  .acs-dot.active{
    width:24px;border-radius:4px;
    background:var(--primary);
  }

  /* Progress bar */
  .acs-progress{
    height:2px;
    background:rgba(230,238,248,0.8);
    margin:0 2rem;
    border-radius:2px;
    overflow:hidden;
  }
  .acs-progress-fill{
    height:100%;
    background:linear-gradient(90deg,var(--primary),var(--secondary));
    border-radius:2px;
    width:25%;
    transition:width 0.5s cubic-bezier(0.22,1,0.36,1);
  }

  /* Mobile: free scroll */
  @media(max-width:768px){
    .about-cards-section{padding:60px 0 0;}
    .acs-header{padding:0 1.25rem 36px;}
    .acs-sticky{position:static;padding-bottom:40px;}
    .acs-track-outer{overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
    .acs-track-outer::-webkit-scrollbar{display:none;}
    .acs-track{
      padding:0 1.25rem;
      gap:16px;
      transition:none;
    }
    .acs-card{
      flex:0 0 272px;
      opacity:1;
      transform:none;
      border-radius:22px;
      padding:28px 24px;
    }
    .acs-card::before{transform:scaleX(1);}
    .acs-num{font-size:2.8rem;top:18px;right:18px;}
    .acs-progress{display:none;}
  }

  /* SERVICES */
  .services{background:var(--blue-mist);}
  .services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem;margin-top:3rem;}
  .service-card{background:var(--white);border:1px solid var(--border);border-radius:14px;padding:1.75rem;transition:all 0.2s;cursor:default;}
  .service-card:hover{border-color:var(--blue);transform:translateY(-3px);box-shadow:0 12px 40px rgba(26,58,92,0.1);}
  .service-icon{width:50px;height:50px;border-radius:10px;background:var(--blue-pale);display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:1rem;border:1px solid var(--border);}
  .service-card h3{font-size:16px;font-weight:600;color:var(--navy);margin-bottom:0.75rem;}
  .service-list{list-style:none;}
  .service-list li{font-size:13px;color:var(--text-muted);padding:3px 0;display:flex;align-items:center;gap:8px;}
  .service-list li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--blue-light);flex-shrink:0;}

  /* ═══════════════════════════════════════════
     BOOKING SECTION — Premium Redesign
     ═══════════════════════════════════════════ */
  .booking{
    background:linear-gradient(160deg,#F8FBFF 0%,#EAF6FF 60%,#F8FBFF 100%);
    padding:100px 0 100px;
    position:relative;
    overflow:hidden;
  }
  .booking::before{
    content:'';
    position:absolute;
    top:-160px;right:-160px;
    width:600px;height:600px;
    border-radius:50%;
    background:radial-gradient(circle,rgba(30,136,229,0.07) 0%,transparent 70%);
    pointer-events:none;
  }
  .booking .container{position:relative;z-index:1;}

  /* Section header */
  .booking .section-eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;letter-spacing:2.8px;text-transform:uppercase;
    color:var(--secondary);
    background:rgba(234,246,255,0.85);
    border:1px solid rgba(30,136,229,0.18);
    border-radius:20px;padding:6px 16px;
    margin-bottom:18px;
  }
  .booking .section-title{
    font-family:'League Spartan',sans-serif;
    font-size:clamp(2.2rem,3.8vw,3.2rem);
    font-weight:800;color:#1A1A1A;
    line-height:1.05;letter-spacing:-0.5px;
    margin-bottom:12px;
  }
  .booking .section-sub{
    font-family:'DM Sans',sans-serif;
    font-size:17px;color:#5F6B7A;line-height:1.7;
    max-width:500px;margin-bottom:0;
  }

  .booking-inner{
    display:grid;
    grid-template-columns:1fr 1.15fr;
    gap:56px;
    align-items:start;
    margin-top:56px;
  }

  /* Left info panel */
  .booking-info{
    display:flex;flex-direction:column;gap:0;
  }
  .booking-info-label{
    font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;
    color:var(--secondary);margin-bottom:24px;
  }

  .booking-steps{
    display:flex;flex-direction:column;gap:0;
    margin-bottom:36px;
  }
  .step{
    display:flex;gap:20px;align-items:flex-start;
    padding-bottom:28px;
    position:relative;
  }
  .step:not(:last-child)::after{
    content:'';
    position:absolute;
    left:18px;top:44px;
    width:1.5px;
    bottom:0;
    background:linear-gradient(to bottom,rgba(30,136,229,0.25),transparent);
  }
  .step-num{
    width:38px;height:38px;border-radius:50%;
    background:linear-gradient(135deg,var(--primary),var(--secondary));
    color:#ffffff;
    display:flex;align-items:center;justify-content:center;
    font-family:'Montserrat',sans-serif;
    font-size:14px;font-weight:800;
    flex-shrink:0;
    box-shadow:0 8px 24px rgba(15,76,129,0.22);
  }
  .step-text{padding-top:6px;}
  .step-text h4{
    font-family:'League Spartan',sans-serif;
    font-size:1.1rem;font-weight:700;
    color:#1A1A1A;margin-bottom:4px;letter-spacing:-0.1px;
  }
  .step-text p{
    font-family:'DM Sans',sans-serif;
    font-size:14px;color:#5F6B7A;line-height:1.6;
  }

  /* Hours card */
  .hours-card{
    background:#ffffff;
    border:1px solid rgba(230,238,248,0.95);
    border-radius:22px;
    padding:28px 28px 24px;
    box-shadow:0 4px 28px rgba(15,76,129,0.07),0 1px 4px rgba(15,76,129,0.04);
    position:relative;overflow:hidden;
  }
  .hours-card::before{
    content:'';
    position:absolute;
    top:0;left:24px;right:24px;height:3px;
    border-radius:0 0 4px 4px;
    background:linear-gradient(90deg,var(--primary),var(--secondary));
  }
  .hours-card h4{
    font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;
    color:var(--secondary);margin-bottom:18px;
  }
  .hour-row{
    display:flex;justify-content:space-between;align-items:center;
    font-size:14px;
    padding:10px 0;
    border-bottom:1px solid rgba(230,238,248,0.8);
  }
  .hour-row:last-child{border-bottom:none;padding-bottom:0;}
  .hour-row span:first-child{
    font-family:'DM Sans',sans-serif;
    color:#5F6B7A;
  }
  .hour-row span:last-child{
    font-family:'DM Sans',sans-serif;
    font-weight:600;color:#1A1A1A;
  }

  /* Calendly embed wrapper */
  .calendly-embed{
    background:#ffffff;
    border:1px solid rgba(230,238,248,0.95);
    border-radius:28px;
    overflow:hidden;
    box-shadow:0 20px 64px rgba(15,76,129,0.10),0 4px 16px rgba(15,76,129,0.06);
  }
  .calendly-embed .calendly-inline-widget{
    border-radius:28px;
  }

  @media(max-width:960px){
    .booking-inner{grid-template-columns:1fr;gap:40px;}
    .booking{padding:72px 0;}
  }

  /* ═══════════════════════════════════════════
     REVIEWS SECTION — Premium Redesign
     ═══════════════════════════════════════════ */
  .reviews{
    background:#ffffff;
    padding:100px 0 100px;
    position:relative;
    overflow:hidden;
  }
  .reviews::before{
    content:'';
    position:absolute;
    bottom:-100px;left:-100px;
    width:500px;height:500px;border-radius:50%;
    background:radial-gradient(circle,rgba(234,246,255,0.5) 0%,transparent 70%);
    pointer-events:none;
  }
  .reviews .container{position:relative;z-index:1;}

  /* Header */
  .reviews-header{
    display:flex;align-items:flex-end;justify-content:space-between;
    margin-bottom:56px;flex-wrap:wrap;gap:1.5rem;
  }
  .reviews-header .section-eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;letter-spacing:2.8px;text-transform:uppercase;
    color:var(--secondary);
    background:rgba(234,246,255,0.85);
    border:1px solid rgba(30,136,229,0.18);
    border-radius:20px;padding:6px 16px;
    margin-bottom:18px;
  }
  .reviews-header .section-title{
    font-family:'League Spartan',sans-serif;
    font-size:clamp(2.2rem,3.8vw,3.2rem);
    font-weight:800;color:#1A1A1A;
    line-height:1.05;letter-spacing:-0.5px;margin-bottom:0;
  }

  /* Rating badge */
  .rating-big{
    display:flex;align-items:center;gap:18px;
    background:#ffffff;
    border:1px solid rgba(230,238,248,0.95);
    border-radius:22px;
    padding:20px 28px;
    box-shadow:0 8px 32px rgba(15,76,129,0.08);
    flex-shrink:0;
  }
  .rating-num{
    font-family:'League Spartan',sans-serif;
    font-size:3.8rem;font-weight:900;
    color:var(--primary);letter-spacing:-2px;line-height:1;
  }
  .rating-stars{
    font-size:18px;color:var(--secondary);
    letter-spacing:3px;display:block;margin-bottom:4px;
  }
  .rating-count{
    font-family:'DM Sans',sans-serif;
    font-size:12px;color:#5F6B7A;font-weight:500;
  }

  /* Reviews grid */
  .reviews-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
  }

  .review-card{
    background:#ffffff;
    border:1px solid rgba(230,238,248,0.9);
    border-radius:24px;
    padding:28px 28px 26px;
    box-shadow:0 4px 24px rgba(15,76,129,0.06),0 1px 4px rgba(15,76,129,0.03);
    transition:transform 0.35s cubic-bezier(0.22,1,0.36,1),
               box-shadow 0.35s cubic-bezier(0.22,1,0.36,1),
               border-color 0.28s ease;
    position:relative;overflow:hidden;
    opacity:0;transform:translateY(24px);
  }
  .review-card.rev-visible{opacity:1;transform:translateY(0);}
  .review-card:nth-child(1){transition-delay:0ms;}
  .review-card:nth-child(2){transition-delay:70ms;}
  .review-card:nth-child(3){transition-delay:140ms;}
  .review-card:nth-child(4){transition-delay:210ms;}
  .review-card:nth-child(5){transition-delay:280ms;}
  .review-card:nth-child(6){transition-delay:350ms;}
  .review-card::before{
    content:'';
    position:absolute;
    top:0;left:24px;right:24px;height:2.5px;
    border-radius:0 0 3px 3px;
    background:linear-gradient(90deg,var(--primary),var(--secondary));
    opacity:0;
    transition:opacity 0.28s ease;
  }
  .review-card:hover{
    transform:translateY(-6px);
    box-shadow:0 20px 56px rgba(15,76,129,0.12),0 4px 12px rgba(15,76,129,0.06);
    border-color:rgba(30,136,229,0.2);
  }
  .review-card:hover::before{opacity:1;}

  /* Quote mark */
  .review-card::after{
    content:'\201C';
    position:absolute;
    top:16px;right:22px;
    font-family:'Playfair Display',serif;
    font-size:5rem;font-weight:700;
    color:rgba(234,246,255,0.9);
    line-height:1;
    pointer-events:none;
    user-select:none;
  }

  .review-top{display:flex;align-items:center;gap:12px;margin-bottom:14px;}
  .reviewer-avatar{
    width:44px;height:44px;border-radius:50%;
    background:linear-gradient(135deg,var(--primary),var(--secondary));
    display:flex;align-items:center;justify-content:center;
    font-family:'League Spartan',sans-serif;
    font-size:15px;font-weight:800;color:#ffffff;
    flex-shrink:0;
    box-shadow:0 6px 18px rgba(15,76,129,0.2);
  }
  .reviewer-name{
    font-family:'DM Sans',sans-serif;
    font-size:15px;font-weight:700;color:#1A1A1A;
    margin-bottom:1px;
  }
  .reviewer-date{
    font-family:'DM Sans',sans-serif;
    font-size:12px;color:#8A97A6;
  }
  .review-stars{
    font-size:14px;color:var(--secondary);
    margin-bottom:12px;letter-spacing:2px;
    display:block;
  }
  .review-text{
    font-family:'DM Sans',sans-serif;
    font-size:14.5px;color:#5F6B7A;
    line-height:1.7;
    position:relative;z-index:1;
  }

  @media(max-width:900px){
    .reviews-grid{grid-template-columns:repeat(2,1fr);}
    .reviews-header{flex-direction:column;align-items:flex-start;}
  }
  @media(max-width:560px){
    .reviews-grid{grid-template-columns:1fr;}
    .reviews{padding:72px 0;}
  }

  /* ═══════════════════════════════════════════
     CONTACT / LOCATION SECTION — Premium Redesign
     ═══════════════════════════════════════════ */
  .contact{
    background:linear-gradient(160deg,#F8FBFF 0%,#EAF6FF 50%,#F8FBFF 100%);
    padding:100px 0 100px;
    position:relative;overflow:hidden;
  }
  .contact::after{
    content:'';
    position:absolute;
    top:-80px;right:-80px;
    width:420px;height:420px;border-radius:50%;
    background:radial-gradient(circle,rgba(30,136,229,0.06) 0%,transparent 70%);
    pointer-events:none;
  }
  .contact .container{position:relative;z-index:1;}

  .contact .section-eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;letter-spacing:2.8px;text-transform:uppercase;
    color:var(--secondary);
    background:rgba(234,246,255,0.85);
    border:1px solid rgba(30,136,229,0.18);
    border-radius:20px;padding:6px 16px;
    margin-bottom:18px;
  }
  .contact .section-title{
    font-family:'League Spartan',sans-serif;
    font-size:clamp(2.2rem,3.8vw,3.2rem);
    font-weight:800;color:#1A1A1A;
    line-height:1.05;letter-spacing:-0.5px;margin-bottom:12px;
  }
  .contact .section-sub{
    font-family:'DM Sans',sans-serif;
    font-size:17px;color:#5F6B7A;line-height:1.7;
    max-width:500px;
  }

  .contact-grid{
    display:grid;
    grid-template-columns:1fr 1.3fr;
    gap:52px;
    margin-top:56px;
    align-items:start;
  }

  .contact-info{display:flex;flex-direction:column;gap:16px;}

  .contact-item{
    display:flex;gap:16px;align-items:flex-start;
    background:#ffffff;
    border:1px solid rgba(230,238,248,0.95);
    border-radius:18px;
    padding:20px 22px;
    box-shadow:0 2px 16px rgba(15,76,129,0.05);
    transition:transform 0.3s cubic-bezier(0.22,1,0.36,1),
               box-shadow 0.3s cubic-bezier(0.22,1,0.36,1),
               border-color 0.25s ease;
  }
  .contact-item:hover{
    transform:translateY(-3px);
    box-shadow:0 12px 40px rgba(15,76,129,0.10);
    border-color:rgba(30,136,229,0.2);
  }
  .contact-icon{
    width:44px;height:44px;border-radius:13px;
    background:linear-gradient(135deg,rgba(234,246,255,0.9),rgba(234,246,255,0.6));
    border:1px solid rgba(30,136,229,0.14);
    display:flex;align-items:center;justify-content:center;
    font-size:20px;flex-shrink:0;
  }
  .contact-item h4{
    font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
    color:var(--secondary);margin-bottom:5px;
  }
  .contact-item p,.contact-item a{
    font-family:'DM Sans',sans-serif;
    font-size:14.5px;color:#1A1A1A;
    text-decoration:none;line-height:1.6;
    font-weight:500;
  }
  .contact-item a:hover{color:var(--secondary);}

  /* Social links row */
  .social-links{display:flex;gap:10px;margin-top:6px;flex-wrap:wrap;}
  .social-btn{
    display:inline-flex;align-items:center;gap:7px;
    background:#ffffff;
    border:1.5px solid rgba(30,136,229,0.18);
    border-radius:999px;
    padding:9px 18px;
    font-family:'Montserrat',sans-serif;
    font-size:12px;font-weight:700;letter-spacing:0.3px;
    color:var(--primary);
    text-decoration:none;
    transition:all 0.25s cubic-bezier(0.22,1,0.36,1);
    box-shadow:0 2px 10px rgba(15,76,129,0.06);
  }
  .social-btn:hover{
    background:var(--primary);color:#ffffff;
    border-color:var(--primary);
    transform:translateY(-2px);
    box-shadow:0 10px 28px rgba(15,76,129,0.22);
  }

  /* Map */
  .map-embed{
    border-radius:24px;overflow:hidden;
    border:1px solid rgba(230,238,248,0.95);
    height:100%;min-height:420px;
    background:rgba(234,246,255,0.5);
    box-shadow:0 20px 64px rgba(15,76,129,0.10),0 4px 16px rgba(15,76,129,0.06);
  }
  .map-embed iframe{width:100%;height:100%;border:none;display:block;}

  @media(max-width:900px){
    .contact-grid{grid-template-columns:1fr;gap:36px;}
    .map-embed{min-height:300px;}
    .contact{padding:72px 0;}
  }

  /* WHATSAPP FLOAT */
  .whatsapp-float{position:fixed;bottom:28px;right:28px;z-index:200;width:56px;height:56px;border-radius:50%;background:var(--primary);display:flex;align-items:center;justify-content:center;box-shadow:0 14px 34px rgba(15,76,129,0.24);text-decoration:none;transition:transform 0.2s,background 0.2s,box-shadow 0.2s;}
  .whatsapp-float:hover{background:var(--secondary);transform:scale(1.06);box-shadow:0 16px 38px rgba(30,136,229,0.24);}
  .whatsapp-float svg{width:30px;height:30px;fill:white;}
  body.menu-open .whatsapp-float{display:none;}

  /* ═══════════════════════════════════════════
     FOOTER — Premium Redesign
     ═══════════════════════════════════════════ */
  footer{
    background:linear-gradient(165deg,#07345D 0%,#0A3D6E 50%,#0F4C81 100%);
    padding:72px 0 0;
    position:relative;overflow:hidden;
  }
  footer::before{
    content:'';
    position:absolute;
    top:-120px;right:-120px;
    width:500px;height:500px;border-radius:50%;
    background:radial-gradient(circle,rgba(30,136,229,0.10) 0%,transparent 70%);
    pointer-events:none;
  }
  footer::after{
    content:'';
    position:absolute;
    bottom:-80px;left:-80px;
    width:360px;height:360px;border-radius:50%;
    background:radial-gradient(circle,rgba(30,136,229,0.06) 0%,transparent 70%);
    pointer-events:none;
  }
  .footer-inner{max-width:1200px;margin:0 auto;padding:0 2rem;position:relative;z-index:1;}

  .footer-top{
    display:grid;
    grid-template-columns:2fr 1fr 1fr;
    gap:64px;
    padding-bottom:56px;
    border-bottom:1px solid rgba(255,255,255,0.08);
  }

  /* Brand col */
  .footer-brand{}
  .footer-brand .logo-text{
    font-family:'League Spartan',sans-serif;
    font-size:1.5rem;font-weight:900;
    letter-spacing:1px;
    color:#ffffff!important;
  }
  .footer-brand .logo-text span{color:rgba(30,136,229,0.9)!important;}
  .footer-brand p{
    font-family:'DM Sans',sans-serif;
    font-size:14px;color:rgba(255,255,255,0.48);
    margin-top:14px;line-height:1.75;
    max-width:280px;
  }

  /* Footer trust badges */
  .footer-trust{
    display:flex;flex-direction:column;gap:10px;
    margin-top:28px;
  }
  .footer-trust-item{
    display:inline-flex;align-items:center;gap:9px;
    font-family:'DM Sans',sans-serif;
    font-size:13px;color:rgba(255,255,255,0.55);
  }
  .footer-trust-dot{
    width:5px;height:5px;border-radius:50%;
    background:rgba(30,136,229,0.7);flex-shrink:0;
  }

  /* Nav cols */
  .footer-col h4{
    font-family:'Montserrat',sans-serif;
    font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;
    color:rgba(255,255,255,0.35);
    margin-bottom:22px;
  }
  .footer-col ul{list-style:none;}
  .footer-col ul li{margin-bottom:12px;}
  .footer-col ul li a{
    font-family:'DM Sans',sans-serif;
    font-size:14.5px;color:rgba(255,255,255,0.62);
    text-decoration:none;
    transition:color 0.22s ease,transform 0.22s ease;
    display:inline-flex;align-items:center;gap:0;
  }
  .footer-col ul li a:hover{color:#ffffff;}

  /* Footer bottom bar */
  .footer-bottom{
    padding:22px 0 24px;
    display:flex;justify-content:space-between;align-items:center;
    flex-wrap:wrap;gap:10px;
    font-family:'DM Sans',sans-serif;
    font-size:13px;color:rgba(255,255,255,0.28);
  }

  @media(max-width:860px){
    .footer-top{grid-template-columns:1fr 1fr;gap:40px;}
    .footer-brand{grid-column:1/-1;}
    .footer-brand p{max-width:100%;}
  }
  @media(max-width:560px){
    .footer-top{grid-template-columns:1fr;gap:36px;padding-bottom:40px;}
    footer{padding:56px 0 0;}
    .footer-bottom{flex-direction:column;align-items:flex-start;gap:6px;}
  }

  /* ── GLOBAL OVERFLOW FIX ── */
  html,body{overflow-x:hidden;max-width:100vw;}

  /* ── NAV RESPONSIVE ── */
  @media(max-width:1100px){
    .nav-links{gap:1.2rem;}
    .nav-links a{font-size:12px;}
  }
  @media(max-width:980px){
    .site-nav{height:72px;}
    .nav-inner{padding:0 20px;justify-content:space-between;}
    .logo-wrap{padding:6px 0;}
    .brand-logo{width:140px;height:48px;object-position:center 53%;}
    .nav-links,
    .nav-actions > .nav-cta,
    .nav-trust-panel{display:none;}
    .menu-toggle{display:flex;}
    body.menu-open .menu-toggle{display:none;}
    body.menu-open .nav-inner{justify-content:center;position:relative;}
    body.menu-open .logo-wrap{position:absolute;left:50%;transform:translateX(-50%);}
    body.menu-open .menu-close{display:flex;}
    body.menu-open .nav-actions{display:flex;position:absolute;right:20px;top:50%;transform:translateY(-50%);}
    .hero{padding-top:72px;}
  }

  /* ── SECTIONS: collapse all grids on mobile ── */
  @media(max-width:900px){
    .hero-inner,.about-grid,.booking-inner,.contact-grid{grid-template-columns:1fr;}
    .hero h1{font-size:2.2rem;}
    .hero-card{display:none;}
    .reviews-header{flex-direction:column;align-items:flex-start;}
  }

  /* ── BOOKING MOBILE ── */
  @media(max-width:768px){
    .booking{padding:60px 0;}
    .booking-inner{margin-top:36px;gap:32px;}
    .calendly-embed .calendly-inline-widget{height:500px;}
    .booking .section-title{font-size:2rem;}
    .booking .section-sub{font-size:15px;}
  }
  @media(max-width:480px){
    .booking{padding:48px 0;}
    .hours-card{padding:20px 18px;}
    .step{gap:14px;padding-bottom:20px;}
    .step-num{width:32px;height:32px;font-size:12px;}
    .step:not(:last-child)::after{left:15px;}
    .calendly-embed .calendly-inline-widget{height:460px;}
  }

  /* ── REVIEWS MOBILE ── */
  @media(max-width:900px){
    .reviews-grid{grid-template-columns:repeat(2,1fr);}
    .reviews{padding:72px 0;}
    .reviews-header{margin-bottom:36px;}
  }
  @media(max-width:560px){
    .reviews-grid{grid-template-columns:1fr;}
    .reviews{padding:52px 0;}
    .rating-big{width:100%;justify-content:flex-start;}
    .review-card{padding:22px 20px;}
  }

  /* ── CONTACT MOBILE ── */
  @media(max-width:900px){
    .contact-grid{grid-template-columns:1fr;gap:32px;}
    .map-embed{min-height:260px;height:260px;}
    .contact{padding:60px 0;}
  }
  @media(max-width:560px){
    .contact{padding:48px 0;}
    .contact-item{padding:16px 16px;}
    .social-links{flex-wrap:wrap;gap:8px;}
    .social-btn{font-size:11px;padding:7px 14px;}
  }

  /* ── FOOTER MOBILE ── */
  @media(max-width:860px){
    .footer-top{grid-template-columns:1fr 1fr;gap:40px;}
    .footer-brand{grid-column:1/-1;}
    .footer-brand p{max-width:100%;}
  }
  @media(max-width:560px){
    .footer-top{grid-template-columns:1fr;gap:32px;padding-bottom:40px;}
    footer{padding:52px 0 0;}
    .footer-bottom{flex-direction:column;align-items:flex-start;gap:6px;font-size:12px;}
  }

  /* ── CONTAINER PADDING ON SMALL SCREENS ── */
  @media(max-width:480px){
    .container{padding:0 1.25rem;}
    .section-title{font-size:1.9rem !important;}
  }

  @media(max-width:600px){
    .hero-stats{gap:1rem;}
  }
</style>
</head>
