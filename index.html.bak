<style>
/* ═══════════════════════════════════════════
   INSTAGRAM REELS SECTION
   ═══════════════════════════════════════════ */
.ig-section{
  background:#ffffff;
  padding:90px 0 80px;
  position:relative;
  overflow:hidden;
}
.ig-section::before{
  content:'';
  position:absolute;top:-100px;right:-100px;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle,rgba(234,246,255,0.5) 0%,transparent 70%);
  pointer-events:none;
}

/* Header */
.ig-header{
  text-align:center;
  max-width:1200px;margin:0 auto;
  padding:0 2rem 56px;
}
.ig-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-family:'Montserrat',sans-serif;
  font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;
  color:var(--secondary);
  background:rgba(234,246,255,0.8);
  border:1px solid rgba(30,136,229,0.18);
  border-radius:20px;padding:6px 14px;
  margin-bottom:20px;
}
.ig-eyebrow-dot{
  width:5px;height:5px;border-radius:50%;
  background:var(--secondary);
  animation:igPulse 2.2s ease-in-out infinite;
}
@keyframes igPulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.65);}}
.ig-title{
  font-family:'League Spartan',sans-serif;
  font-size:clamp(2rem,3.2vw,3rem);
  font-weight:800;color:#1A1A1A;
  line-height:1.05;letter-spacing:-0.4px;
  margin-bottom:14px;
}
.ig-sub{
  font-family:'DM Sans',sans-serif;
  font-size:16px;color:#5F6B7A;line-height:1.7;
}

/* Reels grid */
.ig-reels-row{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  max-width:1200px;margin:0 auto;
  padding:0 2rem;
}

/* Individual reel card */
.ig-reel-card{
  text-decoration:none;
  display:flex;flex-direction:column;
  border-radius:20px;
  overflow:hidden;
  background:#ffffff;
  border:1px solid rgba(230,238,248,0.95);
  box-shadow:0 4px 24px rgba(15,76,129,0.07);
  transition:transform 0.32s cubic-bezier(0.22,1,0.36,1),
             box-shadow 0.32s cubic-bezier(0.22,1,0.36,1),
             border-color 0.28s ease;
}
.ig-reel-card:hover{
  transform:translateY(-6px);
  box-shadow:0 20px 56px rgba(15,76,129,0.13);
  border-color:rgba(30,136,229,0.25);
}

/* Thumbnail — 9:16 reel aspect ratio */
.ig-reel-thumb{
  position:relative;
  aspect-ratio:9/14;
  background:#E8F4FF;
  overflow:hidden;
  display:flex;align-items:center;justify-content:center;
}

/* Gradient backgrounds per card — dental-inspired tones */
.ig-reel-thumb--1{background:linear-gradient(145deg,#0F4C81 0%,#1E88E5 60%,#60C0FF 100%);}
.ig-reel-thumb--2{background:linear-gradient(145deg,#07345D 0%,#0F4C81 55%,#1E5FA0 100%);}
.ig-reel-thumb--3{background:linear-gradient(145deg,#1462A8 0%,#1E88E5 55%,#7DD3FC 100%);}
.ig-reel-thumb--4{background:linear-gradient(145deg,#0F4C81 0%,#1462A8 50%,#60C0FF 100%);}

/* Subtle shimmer lines to mimic video thumbnail */
.ig-reel-thumb::after{
  content:'';
  position:absolute;inset:0;
  background:
    linear-gradient(180deg,
      rgba(255,255,255,0.04) 0%,
      rgba(255,255,255,0.00) 40%,
      rgba(0,0,0,0.18) 100%
    );
  pointer-events:none;
}

/* Play button */
.ig-reel-play{
  width:52px;height:52px;border-radius:50%;
  background:rgba(255,255,255,0.22);
  border:2px solid rgba(255,255,255,0.55);
  display:flex;align-items:center;justify-content:center;
  backdrop-filter:blur(6px);
  -webkit-backdrop-filter:blur(6px);
  transition:transform 0.25s ease,background 0.25s ease;
  position:relative;z-index:2;
}
.ig-reel-play svg{width:18px;height:18px;margin-left:3px;}
.ig-reel-card:hover .ig-reel-play{
  transform:scale(1.12);
  background:rgba(255,255,255,0.35);
}

/* Instagram reel badge — top right */
.ig-reel-label{
  position:absolute;top:12px;right:12px;
  display:flex;align-items:center;gap:5px;
  font-family:'Montserrat',sans-serif;
  font-size:10px;font-weight:700;letter-spacing:0.5px;
  color:#ffffff;
  background:rgba(0,0,0,0.28);
  border-radius:999px;
  padding:4px 10px;
  backdrop-filter:blur(4px);
  z-index:3;
}
.ig-reel-label svg{width:13px;height:13px;flex-shrink:0;}

/* Card info below thumbnail */
.ig-reel-info{
  padding:16px 18px 20px;
  flex:1;
}
.ig-reel-tag{
  display:inline-block;
  font-family:'Montserrat',sans-serif;
  font-size:9px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;
  color:var(--secondary);
  background:rgba(234,246,255,0.85);
  border:1px solid rgba(30,136,229,0.15);
  border-radius:999px;
  padding:3px 10px;
  margin-bottom:8px;
}
.ig-reel-caption{
  font-family:'DM Sans',sans-serif;
  font-size:13px;color:#5F6B7A;
  line-height:1.55;
  margin:0;
}

/* Follow CTA */
.ig-follow-wrap{
  text-align:center;
  margin-top:48px;
  padding:0 2rem;
}
.ig-follow-btn{
  display:inline-flex;align-items:center;gap:10px;
  background:linear-gradient(135deg,#0F4C81,#1E88E5);
  color:#ffffff;
  font-family:'Montserrat',sans-serif;
  font-size:14px;font-weight:700;letter-spacing:0.3px;
  text-decoration:none;
  padding:15px 32px;
  border-radius:999px;
  box-shadow:0 14px 36px rgba(15,76,129,0.25);
  transition:transform 0.25s ease,box-shadow 0.25s ease;
}
.ig-follow-btn svg{width:20px;height:20px;flex-shrink:0;}
.ig-follow-btn:hover{
  transform:translateY(-3px);
  box-shadow:0 20px 48px rgba(15,76,129,0.32);
}
.ig-follow-sub{
  font-family:'DM Sans',sans-serif;
  font-size:13px;color:#5F6B7A;
  margin-top:14px;
}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .ig-reels-row{grid-template-columns:repeat(2,1fr);gap:16px;}
  .ig-section{padding:72px 0 64px;}
}
@media(max-width:560px){
  .ig-section{padding:56px 0 52px;}
  .ig-header{padding-bottom:36px;}
  /* Horizontal scroll on mobile — show 2 at a time */
  .ig-reels-row{
    display:flex;
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:none;
    gap:14px;
    padding:0 1.25rem;
    -webkit-mask-image:linear-gradient(to right,transparent 0%,black 5%,black 90%,transparent 100%);
    mask-image:linear-gradient(to right,transparent 0%,black 5%,black 90%,transparent 100%);
  }
  .ig-reels-row::-webkit-scrollbar{display:none;}
  .ig-reel-card{flex:0 0 220px;}
  .ig-follow-btn{font-size:13px;padding:13px 24px;}
}
</style>


