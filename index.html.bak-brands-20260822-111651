  color:#B9BFD1;letter-spacing:0.05em;
}
.why-card h3{font-size:1.05rem;margin:16px 0 8px;}
.why-card p{font-size:0.89rem;color:var(--muted);line-height:1.6;}

/* ═══════════════════════════════════════════════
   CASE STUDIES
   ═══════════════════════════════════════════════ */
.cases{padding:var(--section-y) 0;background:var(--bg-soft);border-top:1px solid var(--line);}
.case-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
.case-card{
  position:relative;display:flex;flex-direction:column;gap:14px;
  background:var(--navy);border-radius:var(--r-md);
  padding:30px 26px;min-height:220px;
  color:#fff;text-decoration:none;overflow:hidden;
  transition:transform .2s ease,box-shadow .2s ease;
}
.case-card::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(24rem 14rem at 100% 0%,rgba(91,33,201,0.4),transparent 65%);
}
.case-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-2);}
.case-num{
  font-family:var(--font-display);font-size:2.2rem;font-weight:800;
  color:transparent;-webkit-text-stroke:1px rgba(255,255,255,0.4);
  line-height:1;position:relative;
}
.case-card h3{color:#fff;position:relative;}
.case-card p{font-size:0.88rem;color:var(--on-navy);line-height:1.6;position:relative;}
.case-open{
  position:relative;margin-top:auto;
  display:inline-flex;align-items:center;gap:8px;
  font-family:var(--font-display);font-size:0.88rem;font-weight:700;color:var(--accent-on-navy);
}
.case-open svg{width:15px;height:15px;transition:transform .18s ease;}
.case-card:hover .case-open svg{transform:translateX(3px);}

/* ═══════════════════════════════════════════════
   PRESENCE  (dark, India map)
   ═══════════════════════════════════════════════ */
.presence{padding:var(--section-y) 0;background:var(--navy);color:var(--on-navy-strong);position:relative;overflow:hidden;}
.presence::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(42rem 26rem at 14% 0%,rgba(91,33,201,0.30),transparent 62%),
    radial-gradient(32rem 22rem at 96% 100%,rgba(30,111,217,0.18),transparent 60%);
}
.presence .container{position:relative;}
.presence h2{color:#fff;}
.presence-grid{display:grid;grid-template-columns:1fr 0.92fr;gap:clamp(32px,5vw,64px);align-items:center;}
.presence-map{
  background:rgba(255,255,255,0.03);
  border:1px solid var(--line-navy);border-radius:var(--r-lg);
  padding:clamp(16px,2.5vw,28px);
}
.presence-map svg{width:100%;height:auto;display:block;}
.map-body{fill:rgba(255,255,255,0.055);stroke:rgba(201,180,244,0.35);stroke-width:1.6;stroke-linejoin:round;}
.map-link{stroke:rgba(201,180,244,0.28);stroke-width:1;stroke-dasharray:3 5;fill:none;}
.map-pin-dot{fill:url(#pinGrad);}
.map-pin-ring{fill:none;stroke:var(--magenta);stroke-width:1.4;opacity:0.6;transform-origin:center;animation:pinPulse 2.6s ease-out infinite;}
@keyframes pinPulse{
  0%{opacity:0.7;r:6;}
  70%{opacity:0;r:15;}
  100%{opacity:0;r:15;}
}
.map-label{
  font-family:var(--font-display);font-size:12.5px;font-weight:700;
  fill:#fff;letter-spacing:0.03em;
}
.map-label-sub{font-family:var(--font-body);font-size:9.5px;fill:rgba(255,255,255,0.55);}
.presence-note{margin-top:14px;font-size:0.78rem;color:rgba(255,255,255,0.45);text-align:center;}
.city-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:26px;}
.city-card{
  display:flex;align-items:center;gap:12px;
  background:var(--navy-2);border:1px solid var(--line-navy);border-radius:var(--r-sm);
  padding:14px 16px;
  transition:border-color .2s ease,transform .2s ease;
}
.city-card:hover{border-color:rgba(201,180,244,0.4);transform:translateY(-2px);}
.city-card--hq{grid-column:1 / -1;border-color:rgba(201,180,244,0.35);background:linear-gradient(115deg,rgba(74,16,181,0.28),rgba(216,14,128,0.14)),var(--navy-2);}
.city-dot{
  width:10px;height:10px;border-radius:50%;flex-shrink:0;
  background:linear-gradient(135deg,var(--violet-deep),var(--magenta));
  box-shadow:0 0 0 4px rgba(216,14,128,0.16);
}
.city-card strong{font-family:var(--font-display);font-size:0.95rem;font-weight:700;color:#fff;display:block;line-height:1.3;}
.city-card span{font-size:0.78rem;color:var(--on-navy);}

/* ═══════════════════════════════════════════════
   PROCESS
   ═══════════════════════════════════════════════ */
.process{padding:var(--section-y) 0;background:var(--bg-soft);border-top:1px solid var(--line);}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;}
.step{position:relative;padding:0 22px 0 0;}
.step + .step{padding-left:22px;border-left:1px solid var(--line);}
.step-num{
  width:40px;height:40px;border-radius:50%;
  background:linear-gradient(135deg,var(--violet-deep),var(--magenta));
  color:#fff;font-family:var(--font-display);font-weight:800;font-size:0.95rem;
  display:flex;align-items:center;justify-content:center;margin-bottom:16px;
}
.step h3{font-size:1.02rem;margin-bottom:7px;}
.step p{font-size:0.89rem;color:var(--muted);line-height:1.6;}

/* ═══════════════════════════════════════════════
   CTA BAND
   ═══════════════════════════════════════════════ */
.cta-band{padding:var(--section-y) 0;background:var(--navy);position:relative;overflow:hidden;}
.cta-band::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(38rem 22rem at 84% 0%,rgba(91,33,201,0.32),transparent 64%),
    radial-gradient(30rem 20rem at 8% 110%,rgba(216,14,128,0.16),transparent 60%);
}
.cta-inner{position:relative;max-width:720px;margin:0 auto;text-align:center;color:#fff;}
.cta-inner h2{color:#fff;}
.cta-inner p{margin:16px auto 30px;max-width:540px;color:var(--on-navy);}
.cta-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;}
.cta-tags{display:flex;flex-wrap:wrap;justify-content:center;gap:9px;margin-top:32px;}
.cta-tags span{
  font-family:var(--font-display);font-size:0.76rem;font-weight:700;letter-spacing:0.05em;
  color:rgba(255,255,255,0.85);background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.18);border-radius:999px;padding:7px 15px;
}

/* ═══════════════════════════════════════════════
   INSIGHTS / BLOG
   ═══════════════════════════════════════════════ */
.insights{padding:var(--section-y) 0;background:var(--bg);}
.post-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.post-card{
  background:#fff;border:1px solid var(--line);border-radius:var(--r-md);
  overflow:hidden;display:flex;flex-direction:column;
  text-decoration:none;
  transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;
}
.post-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-1);border-color:#D8CBEF;}
.post-photo{aspect-ratio:16/10;overflow:hidden;background:var(--bg-soft);}
.post-photo img{width:100%;height:100%;object-fit:cover;}
.post-body{padding:18px 18px 20px;display:flex;flex-direction:column;flex:1;}
.post-chip{
  align-self:flex-start;
  font-family:var(--font-display);font-size:0.68rem;font-weight:700;
  letter-spacing:0.1em;text-transform:uppercase;color:var(--violet);
  background:rgba(91,33,201,0.08);border-radius:999px;padding:4px 11px;
  margin-bottom:12px;
}
.post-card h3{font-size:1rem;line-height:1.35;color:var(--ink);margin-bottom:8px;}
.post-card p{font-size:0.85rem;color:var(--muted);line-height:1.55;margin-bottom:14px;}
.post-read{
  margin-top:auto;
  display:inline-flex;align-items:center;gap:7px;
  font-family:var(--font-display);font-size:0.85rem;font-weight:700;color:var(--violet);
}
.post-read svg{width:14px;height:14px;transition:transform .18s ease;}
.post-card:hover .post-read svg{transform:translateX(3px);}

/* ═══════════════════════════════════════════════
   CONTACT
   ═══════════════════════════════════════════════ */
.contact{padding:var(--section-y) 0;background:var(--bg-soft);border-top:1px solid var(--line);}
.contact-grid{display:grid;grid-template-columns:1fr 0.92fr;gap:clamp(32px,4.5vw,60px);align-items:start;}
.contact-list{display:grid;gap:8px;}
.contact-row{
  display:flex;gap:16px;align-items:flex-start;
  padding:18px;border:1px solid var(--line);border-radius:var(--r-md);background:#fff;
}
.contact-row h3{font-size:0.98rem;margin-bottom:3px;}
.contact-row p{font-size:0.92rem;color:var(--muted);line-height:1.6;}
.contact-row a{color:var(--violet);font-weight:600;text-decoration:none;word-break:break-word;}
.contact-row a:hover{text-decoration:underline;}
.contact-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:18px;}
.contact-media{
  border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-1);
  aspect-ratio:4/3;background:#fff;border:1px solid var(--line);
}
.contact-media iframe{width:100%;height:100%;}

