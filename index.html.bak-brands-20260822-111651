<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Viveins Technologies Pvt. Ltd. | Audiovisual Solutions for Modern Spaces</title>
<meta name="description" content="Viveins Technologies Pvt. Ltd. delivers reliable, innovative audiovisual solutions for businesses, educational institutions, hospitality venues, auditoriums, museums and heritage spaces, from consultation and design to installation, programming, training and support."/>
<meta property="og:title" content="Viveins Technologies Pvt. Ltd. | Audiovisual Solutions for Modern Spaces"/>
<meta property="og:description" content="Reliable, innovative audiovisual solutions: consultation, system design, integration, installation, programming, training and support."/>
<meta property="og:type" content="website"/>
<meta property="og:image" content="logo-lockup.png"/>
<meta name="theme-color" content="#0B1030"/>
<link rel="icon" type="image/png" href="favicon.png"/>
<link rel="apple-touch-icon" href="favicon.png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet"/>
<style>
/* ═══════════════════════════════════════════════
   DESIGN TOKENS
   ═══════════════════════════════════════════════ */
:root{
  /* Color */
  --ink:#101430;
  --ink-soft:#3C4258;
  --muted:#5B6274;
  --bg:#FFFFFF;
  --bg-soft:#F6F7FB;
  --navy:#0B1030;
  --navy-2:#12183D;
  --line:#E5E8F0;
  --line-navy:rgba(255,255,255,0.12);
  --on-navy:rgba(255,255,255,0.74);
  --on-navy-strong:#FFFFFF;

  /* Brand accents (from logo) */
  --blue:#1E6FD9;
  --violet:#5B21C9;
  --violet-deep:#4A10B5;
  --magenta:#D80E80;
  --accent:#5B21C9;
  --accent-on-navy:#C9B4F4;
  --grad-cta:linear-gradient(115deg,#4A10B5 0%,#8A14A8 55%,#D80E80 100%);

  /* Shape & elevation */
  --r-sm:10px;
  --r-md:14px;
  --r-lg:18px;
  --shadow-1:0 1px 2px rgba(16,20,48,0.05),0 6px 20px rgba(16,20,48,0.06);
  --shadow-2:0 2px 6px rgba(16,20,48,0.07),0 18px 44px rgba(16,20,48,0.10);

  /* Type */
  --font-display:'Manrope',system-ui,-apple-system,'Segoe UI',sans-serif;
  --font-body:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;

  /* Layout */
  --container:1240px;
  --gutter:clamp(20px,4.5vw,32px);
  --header-h:80px;
  --section-y:clamp(64px,9vw,104px);
}

/* ═══════════════════════════════════════════════
   BASE
   ═══════════════════════════════════════════════ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;}
body{
  font-family:var(--font-body);
  font-size:16px;line-height:1.65;
  color:var(--ink);background:var(--bg);
  overflow-x:hidden;
  overflow-x:clip;
}
img{max-width:100%;display:block;}
a{color:var(--accent);}
ul{list-style:none;}
button{font:inherit;background:none;border:0;cursor:pointer;color:inherit;}
iframe{border:0;display:block;}
:focus-visible{outline:2px solid var(--violet);outline-offset:3px;border-radius:4px;}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}
section{scroll-margin-top:calc(var(--header-h) + 12px);}

.container{max-width:var(--container);margin:0 auto;padding-left:var(--gutter);padding-right:var(--gutter);}

/* Typography scale */
h1,h2,h3,h4{font-family:var(--font-display);color:inherit;letter-spacing:-0.015em;}
h1{font-size:clamp(2.15rem,5.2vw,3.35rem);line-height:1.08;font-weight:800;}
h2{font-size:clamp(1.6rem,3.1vw,2.3rem);line-height:1.15;font-weight:800;}
h3{font-size:1.15rem;line-height:1.3;font-weight:700;}
.lead{font-size:clamp(1rem,1.4vw,1.13rem);color:var(--muted);}

/* Section header pattern */
.sec-head{max-width:640px;margin-bottom:clamp(36px,5vw,56px);}
.sec-head.center{margin-left:auto;margin-right:auto;text-align:center;}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-family:var(--font-display);font-size:0.72rem;font-weight:700;
  letter-spacing:0.14em;text-transform:uppercase;
  color:var(--accent);margin-bottom:14px;
}
.eyebrow::before{content:'';width:18px;height:2px;background:var(--magenta);border-radius:2px;}
.sec-head p{margin-top:12px;color:var(--muted);}
.on-dark .eyebrow{color:var(--accent-on-navy);}
.on-dark .sec-head p{color:var(--on-navy);}

/* Buttons */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  min-height:48px;padding:12px 26px;border-radius:var(--r-sm);
  font-family:var(--font-display);font-size:0.95rem;font-weight:700;
  text-decoration:none;white-space:nowrap;
  transition:transform .18s ease,box-shadow .18s ease,background-color .18s ease,border-color .18s ease,filter .18s ease;
}
.btn svg{width:17px;height:17px;flex-shrink:0;}
.btn-primary{
  background:var(--grad-cta);color:#fff;
  box-shadow:0 8px 22px rgba(122,16,150,0.28);
}
.btn-primary:hover{filter:brightness(1.07);transform:translateY(-1px);box-shadow:0 12px 28px rgba(122,16,150,0.34);}
.btn-secondary{
  background:var(--bg);color:var(--ink);
  border:1px solid #CBD1DE;
}
.btn-secondary:hover{border-color:var(--violet);color:var(--violet);transform:translateY(-1px);}
.btn-on-dark{
  background:rgba(255,255,255,0.07);color:#fff;
  border:1px solid rgba(255,255,255,0.28);
}
.btn-on-dark:hover{background:rgba(255,255,255,0.14);transform:translateY(-1px);}
.btn-white{background:#fff;color:var(--violet-deep);box-shadow:0 10px 26px rgba(0,0,0,0.22);}
.btn-white:hover{transform:translateY(-1px);filter:brightness(0.97);}

/* Text link with arrow */
.link-arrow{
  display:inline-flex;align-items:center;gap:7px;
  font-family:var(--font-display);font-weight:700;font-size:0.92rem;
  color:var(--violet);text-decoration:none;min-height:44px;
}
.link-arrow svg{width:15px;height:15px;transition:transform .18s ease;}
.link-arrow:hover svg{transform:translateX(3px);}
.on-dark .link-arrow{color:var(--accent-on-navy);}

/* Icon tile */
.icon-tile{
  width:44px;height:44px;border-radius:12px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg,rgba(74,16,181,0.10),rgba(216,14,128,0.10));
  color:var(--violet);
}
.icon-tile svg{width:22px;height:22px;}
.on-dark .icon-tile{background:rgba(255,255,255,0.08);color:var(--accent-on-navy);}

/* Reveal on scroll (motion-safe only) */
.reveal{opacity:0;transform:translateY(16px);transition:opacity .55s ease,transform .55s ease;}
.reveal.in{opacity:1;transform:none;}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto;}
  *,*::before,*::after{animation:none!important;transition:none!important;}
  .reveal{opacity:1;transform:none;}
}

/* ═══════════════════════════════════════════════
   HEADER
   ═══════════════════════════════════════════════ */
.site-header{
  position:fixed;top:0;left:0;right:0;z-index:100;
  height:var(--header-h);
  background:rgba(255,255,255,0.88);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid transparent;
  transition:border-color .25s ease,box-shadow .25s ease,background-color .25s ease;
}
.site-header.scrolled{border-bottom-color:var(--line);box-shadow:0 4px 18px rgba(16,20,48,0.06);}
.header-inner{
  max-width:var(--container);margin:0 auto;height:100%;
  padding:0 var(--gutter);
  display:flex;align-items:center;justify-content:space-between;gap:20px;
}
.brand{display:inline-flex;align-items:center;text-decoration:none;flex-shrink:0;}
.brand img{height:52px;width:auto;}
.main-nav ul{display:flex;align-items:center;gap:clamp(16px,2.1vw,30px);}
.main-nav a{
  font-family:var(--font-display);font-size:0.92rem;font-weight:600;
  color:var(--ink-soft);text-decoration:none;padding:8px 2px;
  border-bottom:2px solid transparent;
  transition:color .18s ease;
  white-space:nowrap;
}
.main-nav a:hover{color:var(--violet);}
.header-cta{min-height:44px;padding:10px 20px;font-size:0.9rem;}
.menu-btn{
  display:none;width:44px;height:44px;border-radius:10px;
  align-items:center;justify-content:center;color:var(--ink);
}
.menu-btn svg{width:24px;height:24px;}

/* Mobile drawer */
.drawer-backdrop{
  position:fixed;inset:0;z-index:110;background:rgba(11,16,48,0.5);
  opacity:0;pointer-events:none;transition:opacity .25s ease;
}
.drawer{
  position:fixed;top:0;right:0;bottom:0;z-index:120;
  width:min(360px,88vw);
  background:#fff;border-left:1px solid var(--line);
  display:flex;flex-direction:column;
  transform:translateX(102%);transition:transform .28s ease;
  overflow-y:auto;overscroll-behavior:contain;
}
body.menu-open .drawer{transform:none;}
body.menu-open .drawer-backdrop{opacity:1;pointer-events:auto;}
body.menu-open{overflow:hidden;}
.drawer-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 20px;border-bottom:1px solid var(--line);min-height:64px;flex-shrink:0;
}
.drawer-head .brand img{height:36px;}
.drawer-close{
  width:44px;height:44px;border-radius:10px;
  display:flex;align-items:center;justify-content:center;color:var(--ink);
  background:var(--bg-soft);
}
.drawer-close svg{width:20px;height:20px;}
.drawer-nav{padding:10px 8px;}
.drawer-nav a{
  display:flex;align-items:center;justify-content:space-between;
  padding:11px 14px;min-height:46px;border-radius:10px;
  font-family:var(--font-display);font-size:1rem;font-weight:700;
  color:var(--ink);text-decoration:none;
}
.drawer-nav a:hover{background:var(--bg-soft);color:var(--violet);}
.drawer-nav a svg{width:16px;height:16px;color:#A6ADC0;flex-shrink:0;}
.drawer-foot{margin-top:auto;padding:18px 20px 26px;border-top:1px solid var(--line);}
.drawer-foot .btn{width:100%;margin-bottom:14px;}
.drawer-foot p{font-size:0.85rem;color:var(--muted);line-height:1.6;}
.drawer-foot a.mail{color:var(--violet);text-decoration:none;font-weight:600;word-break:break-all;}

/* ═══════════════════════════════════════════════
   HERO
   ═══════════════════════════════════════════════ */
.hero{
  padding-top:calc(var(--header-h) + clamp(40px,6vw,76px));
  padding-bottom:clamp(48px,6vw,84px);
  background:
    radial-gradient(46rem 26rem at 88% -10%,rgba(91,33,201,0.07),transparent 62%),
    radial-gradient(34rem 22rem at -10% 108%,rgba(216,14,128,0.05),transparent 60%),
    var(--bg-soft);
  border-bottom:1px solid var(--line);
}
.hero-grid{
  display:grid;grid-template-columns:1.04fr 0.96fr;
  gap:clamp(36px,5vw,64px);align-items:center;
}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-family:var(--font-display);font-size:0.74rem;font-weight:700;
  letter-spacing:0.13em;text-transform:uppercase;color:var(--violet);
  background:#fff;border:1px solid var(--line);border-radius:999px;
  padding:7px 14px;margin-bottom:22px;
}
.hero-eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--magenta);}
.hero h1 .accent{
  background:linear-gradient(100deg,var(--violet-deep),var(--magenta));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero .lead{margin-top:18px;max-width:520px;}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px;}
.hero-proof{margin-top:32px;display:grid;gap:11px;}
.hero-proof li{
  display:flex;align-items:flex-start;gap:11px;
  font-size:0.95rem;font-weight:500;color:var(--ink-soft);
}
.tick{
  width:20px;height:20px;border-radius:50%;flex-shrink:0;margin-top:2px;
  background:linear-gradient(135deg,var(--violet-deep),var(--magenta));
  display:flex;align-items:center;justify-content:center;
}
.tick svg{width:10px;height:10px;stroke:#fff;stroke-width:2.6;fill:none;stroke-linecap:round;stroke-linejoin:round;}
.hero-media{position:relative;}
.hero-media .frame{
  position:relative;border-radius:var(--r-lg);overflow:hidden;
  box-shadow:var(--shadow-2);
  aspect-ratio:4/3;background:var(--navy);
}
.hero-media .frame img{width:100%;height:100%;object-fit:cover;}
.hero-media .caption{
  position:absolute;left:0;right:0;bottom:0;
  padding:40px 22px 16px;
  background:linear-gradient(to top,rgba(11,16,48,0.86),rgba(11,16,48,0));
  display:flex;align-items:center;gap:12px;
}
.hero-media .caption .cap-dot{
  width:9px;height:9px;border-radius:50%;background:var(--magenta);flex-shrink:0;
  box-shadow:0 0 0 4px rgba(216,14,128,0.25);
}
.hero-media .caption p{font-size:0.88rem;font-weight:600;color:#fff;line-height:1.45;}
.hero-media .caption span{display:block;font-size:0.78rem;font-weight:400;color:rgba(255,255,255,0.72);}

/* Capability strip */
.cap-strip{background:var(--navy);}
.cap-strip-inner{
  max-width:var(--container);margin:0 auto;padding:20px var(--gutter);
  display:flex;flex-wrap:wrap;align-items:center;justify-content:center;
  gap:14px 38px;
}
.cap-item{
  display:inline-flex;align-items:center;gap:9px;
  font-family:var(--font-display);font-size:0.83rem;font-weight:600;
  letter-spacing:0.02em;color:var(--on-navy);white-space:nowrap;
}
.cap-item svg{width:16px;height:16px;stroke:var(--accent-on-navy);flex-shrink:0;}

/* ═══════════════════════════════════════════════
   BRANDS MARQUEE: partner tiles, two counter-scrolling rows
   ═══════════════════════════════════════════════ */
.brands{
  padding:clamp(48px,6.5vw,76px) 0 clamp(52px,7vw,84px);
  background:
    radial-gradient(36rem 20rem at 50% -30%,rgba(91,33,201,0.06),transparent 65%),
    var(--bg);
  border-bottom:1px solid var(--line);
  overflow:hidden;
}
.brands .sec-head{margin-bottom:clamp(28px,4vw,40px);}
.brands-viewport{
  overflow:hidden;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);
}
.brands-viewport + .brands-viewport{margin-top:16px;}
.brands-track{display:flex;width:max-content;animation:brandScroll 44s linear infinite;}
.brands-track.rev{animation-duration:52s;animation-direction:reverse;}
.brands-viewport:hover .brands-track{animation-play-state:paused;}
.brands-set{display:flex;align-items:stretch;gap:16px;padding-right:16px;}
@keyframes brandScroll{to{transform:translateX(-50%);}}
.brand-tile{
  display:flex;align-items:center;gap:15px;
  background:#fff;border:1px solid var(--line);border-radius:var(--r-md);
  padding:16px 26px 16px 18px;min-width:230px;
  box-shadow:0 1px 2px rgba(16,20,48,0.04);
  transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease;
}
.brand-tile:hover{
  transform:translateY(-3px);
  border-color:#D8CBEF;
  box-shadow:0 2px 6px rgba(16,20,48,0.06),0 14px 32px rgba(74,16,181,0.10);
}
.brand-badge{
  width:42px;height:42px;border-radius:11px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-display);font-size:1.05rem;font-weight:800;
  color:var(--violet);
  background:linear-gradient(135deg,rgba(74,16,181,0.10),rgba(216,14,128,0.10));
  border:1px solid rgba(91,33,201,0.14);
  transition:color .22s ease,background .22s ease,border-color .22s ease;
}
.brand-tile:hover .brand-badge{
  color:#fff;
  background:var(--grad-cta);
  border-color:transparent;
}
.brand-tile strong{
  display:block;
  font-family:var(--font-display);font-size:1.02rem;font-weight:800;
  letter-spacing:0.12em;color:var(--ink);line-height:1.25;white-space:nowrap;
}
.brand-tile div span{
  display:block;
  font-family:var(--font-display);font-size:0.68rem;font-weight:700;
  letter-spacing:0.09em;text-transform:uppercase;color:#9AA1B5;white-space:nowrap;
}
@media (prefers-reduced-motion:reduce){
  .brands-track{width:auto;flex-wrap:wrap;justify-content:center;}
  .brands-set{flex-wrap:wrap;justify-content:center;padding-right:0;}
  .brands-set + .brands-set{display:none;}
  .brands-viewport + .brands-viewport{display:none;}
  .brands-viewport{-webkit-mask-image:none;mask-image:none;}
}

/* ═══════════════════════════════════════════════
   ABOUT
   ═══════════════════════════════════════════════ */
.about{padding:var(--section-y) 0;background:var(--bg);}
.about-grid{
  display:grid;grid-template-columns:1fr 0.88fr;
  gap:clamp(36px,5vw,72px);align-items:center;
}
.about .sec-head{margin-bottom:0;}
.about-points{margin-top:26px;display:grid;gap:12px;}
.about-points li{display:flex;align-items:flex-start;gap:11px;font-size:0.95rem;font-weight:500;color:var(--ink-soft);}
.about-media{border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-1);aspect-ratio:4/3;background:var(--bg-soft);}
.about-media img{width:100%;height:100%;object-fit:cover;}

/* ═══════════════════════════════════════════════
   SERVICES (lifecycle)
   ═══════════════════════════════════════════════ */
.services{padding:var(--section-y) 0;background:var(--bg-soft);border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
.svc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
.svc-card{
  background:#fff;border:1px solid var(--line);border-radius:var(--r-md);
  padding:28px 26px;position:relative;
  display:flex;flex-direction:column;
  box-shadow:var(--shadow-1);
  transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;
}
.svc-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-2);border-color:#D8CBEF;}
.svc-num{
  position:absolute;top:24px;right:24px;
  font-family:var(--font-display);font-size:0.8rem;font-weight:800;
  color:#B9BFD1;letter-spacing:0.05em;
}
.svc-card h3{font-size:1.18rem;margin:18px 0 6px;}
.svc-tagline{
  font-family:var(--font-display);font-size:0.93rem;font-weight:700;
  color:var(--violet);margin-bottom:10px;
}
.svc-card p.svc-desc{font-size:0.92rem;color:var(--muted);line-height:1.65;margin-bottom:18px;}
.svc-card .link-arrow{margin-top:auto;}
.svc-card--wide{grid-column:1 / -1;}
.svc-card--wide .svc-inner{display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:center;}
.svc-card--wide h3{margin-top:0;}
.svc-card--wide p.svc-desc{margin-bottom:0;max-width:640px;}
.svc-card--wide .link-arrow{margin-top:0;}

/* ═══════════════════════════════════════════════
   SOLUTIONS (spaces)
   ═══════════════════════════════════════════════ */
.solutions{padding:var(--section-y) 0;background:var(--bg);}
.sol-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
.sol-card{
  background:#fff;border:1px solid var(--line);border-radius:var(--r-md);
  overflow:hidden;display:flex;flex-direction:column;
  box-shadow:var(--shadow-1);
  transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;
}
.sol-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-2);border-color:#D8CBEF;}
.sol-photo{position:relative;aspect-ratio:3/2;overflow:hidden;background:var(--navy);}
.sol-photo img{width:100%;height:100%;object-fit:cover;}
.sol-photo .tag{
  position:absolute;left:14px;bottom:14px;
  display:inline-flex;align-items:center;gap:9px;
  background:rgba(11,16,48,0.78);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  border:1px solid rgba(255,255,255,0.16);border-radius:8px;
  padding:6px 12px;
  font-family:var(--font-display);font-size:0.75rem;font-weight:700;color:#fff;letter-spacing:0.04em;
}
.sol-photo .tag em{font-style:normal;color:var(--accent-on-navy);}
.sol-body{padding:24px 24px 26px;display:flex;flex-direction:column;flex:1;}
.sol-body h3{margin-bottom:8px;}
.sol-body .sub{font-size:0.93rem;color:var(--muted);margin-bottom:18px;}
.sol-list{display:grid;gap:12px;margin-bottom:20px;}
.sol-list li{display:flex;gap:11px;align-items:flex-start;}
.sol-list .mark{
  width:6px;height:6px;border-radius:50%;background:var(--magenta);
